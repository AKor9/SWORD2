// Ожидаемые расхождения пака пекарни с эталонным паком SWORD (Content.reference.swpak):
//   sword-bake diff ..\Content.reference.swpak ..\Content.swpak --expect reference.expect.json --json
// Что отличается по устройству и расхождением не считается:
// - SourceHash клипов .swclip: в эталоне в него входит MVID сборок конвертера SWORD, в SWORD2 — нет; клипы сравнивает
//   сравнитель плагина Sword.Bake.Engine по всем полям, кроме SourceHash («равны по содержимому»);
// - .bake/build.json: время сборки и входов, отпечатки кода (у отпечатка сравниваются только ID и версия обработчика —
//   сборки после деления Sword.Bake.Sword на Engine и Game другие). paramsHash включает корни исходников: он равен при
//   тех же корнях, что у эталона (src = D:/Temp/GamedevAssets, assets = D:/Temp/AssetsDatabase).
// Новое правило — только с причиной, которую понимаешь; правило, не подошедшее ни к чему, diff называет.
{
  "expected": [
    { "path": "weapons", "expect": "different", "reason": "хват оружия — ось рукояти через центры изгиба пальцев, а не линия костяшек (SkinBake.GripAttachment): меши и зоны крови в системе кисти другие" },
    { "asset": "weapons/*", "expect": "different", "reason": "то же: выходы оружия другие" },
    { "path": "weapons/torch.*", "expect": "absent", "reason": "факел (этап 15, огонь) — своего оружия нет в эталоне: меш tools/scripts/torch_mesh.py" },
    { "asset": "weapons/torch", "expect": "absent", "reason": "то же: ассет факела только в паке пекарни" },
    { "path": "effects/fire", "expect": "absent", "reason": "текстуры огня (этап 15) — из VFX Tools, в эталоне их нет" },
    { "asset": "effects/fire/*", "expect": "absent", "reason": "то же: ассеты текстур огня только в паке пекарни" }
  ]
}
