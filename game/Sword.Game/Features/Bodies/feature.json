{
  // Приёмка фичи «Физика и тела» (этап 5) — точки 5а (подсистема Physics, хуки ECS, тело бойца — сочленение из 13
  // кинематических капсул за BodyRef, участник хеша physics, инварианты physics.finite/bodyRefs) и 5б (капсулы по позе:
  // форма и постановка при постройке, постановка по позе тика в PrePhysics, инварианты physics.kinematicPose/kinematicSpeed,
  // метрики против трассы SWORD по вычисляемым полям тела Body.* — Game.Agent.BodyFields) и 5в (капсулы на экране и агенту:
  // виды с оверлеем капсул — Sword.exe --overlay capsules; тела сборки мира стоят до первого тика). Бюджеты — у фичи enemies
  // (crowd, стадия PrePhysics; кадр App); полный манифест — на 5г. Формат — FeatureManifest
  // (Sword.Engine.Introspection), исполняет feature.verify (Sword.Headless --feature bodies). Ослабить ожидания — только
  // правкой с сообщением пользователю.
  "format": "sword-feature",
  "version": 1,
  "id": "bodies",
  "title": "Физика и тела (этап 5; 5а — Physics, хуки ECS, тела бойцов за BodyRef; 5б — капсулы по позе; 5в — капсулы на экране и агенту)",
  "doc": "README.md",
  "sourceRoots": [
    "engine/Sword.Engine.Physics",
    "engine/Sword.Engine.Ecs/WorldHooks.cs",
    "engine/Sword.Engine.Ecs/Hooks.cs",
    "game/Sword.Game/Bodies",
    "game/Sword.Game.Contracts/BodySegs.cs",
    "game/Sword.Game.Contracts/Components.cs",
    "game/Sword.Game.Contracts/Views.cs",
    "game/Sword.Game/Arena/ArenaSpawn.cs",
    "game/Sword.Game/Arena/ArenaTerrain.cs",
    "game/Sword.Game/GameCore.cs",
    "game/Sword.Game.Agent/PhysicsTools.cs",
    "game/Sword.Game/Bodies/JointSegments.cs",
    "game/Sword.Game.Client/ArenaView.cs",
    "game/Sword.Game.Client/ArenaClient.cs",
    "engine/Sword.Engine.Render/DebugDraw.cs",
    "engine/Sword.Engine.Render/Shaders/common/debug.hlsl",
    "engine/Sword.Engine.Agent.Client/ClientAgent.cs"
  ],
  "requiredModules": ["locomotion"],
  "scenarios": [
    {
      "id": "arena",
      "title": "тела при командах арены: PageUp, до 32, PageDown ×10, R, до 0, PageUp — у каждого бойца своё тело, лишних нет (physics.bodyRefs); построенные и построенные заново бойцы встают по позе постройки без скачка капсул (physics.kinematicSpeed), капсулы на суставах (physics.kinematicPose)",
      "set": ["arena.enemies=10"],
      "ticks": 480,
      "commands": [
        { "command": "PlayerCommand", "fields": { "Move": { "X": 1, "Y": 0.5 } }, "from": 0, "to": 240 },
        { "command": "ArenaCommand", "fields": { "Action": "ChangeEnemies", "Enemies": 1 }, "from": 60, "to": 61 },
        { "command": "ArenaCommand", "fields": { "Action": "SetEnemies", "Enemies": 32 }, "from": 120, "to": 121 },
        { "command": "ArenaCommand", "fields": { "Action": "ChangeEnemies", "Enemies": -1 }, "from": 180, "to": 190 },
        { "command": "ArenaCommand", "fields": { "Action": "Reset" }, "from": 300, "to": 301 },
        { "command": "ArenaCommand", "fields": { "Action": "SetEnemies", "Enemies": 0 }, "from": 360, "to": 361 },
        { "command": "ArenaCommand", "fields": { "Action": "ChangeEnemies", "Enemies": 1 }, "from": 420, "to": 421 }
      ],
      "checks": [
        {
          "id": "every-fighter", "title": "у каждого бойца есть тело (BodyRef), других владельцев тел нет", "expect": "always",
          "condition": {
            "all": [
              { "none": { "all": [{ "component": "Fighter" }, { "not": { "component": "BodyRef" } }] } },
              { "none": { "all": [{ "component": "BodyRef" }, { "not": { "component": "Fighter" } }] } }
            ]
          }
        },
        {
          "id": "eleven", "title": "PageUp — тел 12", "expect": "always", "from": 62, "to": 120,
          "condition": { "count": { "component": "BodyRef" }, "equals": 12 }
        },
        {
          "id": "thirty-three", "title": "32 врага — тел 33", "expect": "always", "from": 122, "to": 180,
          "condition": { "count": { "component": "BodyRef" }, "equals": 33 }
        },
        {
          "id": "page-down", "title": "PageDown ×10 — тел 23", "expect": "always", "from": 191, "to": 300,
          "condition": { "count": { "component": "BodyRef" }, "equals": 23 }
        },
        {
          "id": "reset", "title": "R — бойцы построены заново на тех же сущностях, тел по-прежнему 23", "expect": "always", "from": 302, "to": 360,
          "condition": { "count": { "component": "BodyRef" }, "equals": 23 }
        },
        {
          "id": "zero", "title": "0 врагов — одно тело (игрок)", "expect": "always", "from": 362, "to": 420,
          "condition": { "count": { "component": "BodyRef" }, "equals": 1 }
        },
        {
          "id": "page-up-again", "title": "PageUp — тел 2", "expect": "always", "from": 422,
          "condition": { "count": { "component": "BodyRef" }, "equals": 2 }
        }
      ]
    },
    {
      "id": "terrain",
      "title": "рельеф: игрок бежит на склон (0, 18) до вершины 1,6 м, затем через ступенчатую пирамиду (−16, 0: пять ярусов по 12 см) и стоит на её верхнем ярусе — капсулы идут за позой и рельефом под корнем, на суставах (physics.kinematicPose), без скачков на кромках ступеней (physics.kinematicSpeed)",
      "set": ["arena.enemies=0"],
      "ticks": 1400,
      "commands": [
        { "command": "PlayerCommand", "fields": { "Move": { "X": 0, "Y": 1 } }, "from": 0, "to": 520 },
        { "command": "PlayerCommand", "fields": { "Move": { "X": -0.62, "Y": -0.78 } }, "from": 520, "to": 1240 }
      ],
      "checks": [
        {
          "id": "on-slope", "title": "игрок поднялся на склон — ближе 2 м к вершине (0, 18)", "expect": "eventually", "to": 600,
          "condition": { "all": [{ "entity": "player" }, { "field": "Transform.Position.Z", "greaterThan": 16 }, { "field": "Transform.Position.Z", "lessThan": 20 }, { "field": "Transform.Position.X", "greaterThan": -2 }, { "field": "Transform.Position.X", "lessThan": 2 }] }
        },
        {
          "id": "on-steps", "title": "игрок на верхнем ярусе пирамиды: max(|x + 16|, |z|) < 2", "expect": "atEnd",
          "condition": { "all": [{ "entity": "player" }, { "field": "Transform.Position.X", "greaterThan": -18 }, { "field": "Transform.Position.X", "lessThan": -14 }, { "field": "Transform.Position.Z", "greaterThan": -2 }, { "field": "Transform.Position.Z", "lessThan": 2 }] }
        }
      ]
    },
    {
      "id": "reference",
      "title": "эталон SWORD2 enemies (сценарий трассы толпы SWORD sword-crowd: толпа, команды арены по ходу, рельеф холмов по пути к колонне): хеши участника physics каждого тика; тела — против трассы SWORD",
      "replay": "tests/reference/replays/enemies.swreplay",
      "checks": [
        {
          "id": "every-fighter", "title": "у каждого бойца есть тело (BodyRef)", "expect": "always",
          "condition": { "none": { "all": [{ "component": "Fighter" }, { "not": { "component": "BodyRef" } }] } }
        },
        {
          "id": "end-33", "title": "в конце 33 тела", "expect": "eventually", "from": 2990,
          "condition": { "count": { "component": "BodyRef" }, "equals": 33 }
        }
      ]
    }
  ],
  "invariants": ["ecs.finite", "physics.*"],
  "metrics": [
    {
      "id": "sword-crowd-pelvis-player", "scenario": "reference", "source": "sword",
      "reference": "трасса толпы SWORD 2eab13b на эталонном паке (tests/reference/sword-trace, сценарий crowd; 5б — копии PlaceBodies и формы при постройке Fighter.Build): центр капсулы таза игрока тик за тиком, побитово; все 13 капсул всех бойцов каждого тика (центр, поворот, прошлая постановка, скорости, форма: 53 400 бойце-тиков) — ReferenceTraceTests.Crowd_MatchesSwordTickByTick",
      "entity": "player", "trace": "tests/reference/anim-crowd.trace.json",
      "series": { "pelvis0[0]": "Body.pelvis.Position.X", "pelvis0[1]": "Body.pelvis.Position.Y", "pelvis0[2]": "Body.pelvis.Position.Z" },
      "tolerance": 0
    },
    {
      "id": "sword-crowd-pelvis-enemy-1", "scenario": "reference", "source": "sword",
      "reference": "трасса толпы SWORD (5б): центр капсулы таза врага места 1 тик за тиком, побитово",
      "entity": "enemy 1", "trace": "tests/reference/anim-crowd.trace.json",
      "series": { "pelvis1[0]": "Body.pelvis.Position.X", "pelvis1[1]": "Body.pelvis.Position.Y", "pelvis1[2]": "Body.pelvis.Position.Z" },
      "tolerance": 0
    },
    {
      "id": "sword-crowd-pelvis-enemy-12", "scenario": "reference", "source": "sword",
      "reference": "трасса толпы SWORD (5б): центр капсулы таза врага места 12 (строится заново сбросом R) тик за тиком, побитово",
      "entity": "enemy 12", "trace": "tests/reference/anim-crowd.trace.json",
      "series": { "pelvis12[0]": "Body.pelvis.Position.X", "pelvis12[1]": "Body.pelvis.Position.Y", "pelvis12[2]": "Body.pelvis.Position.Z" },
      "tolerance": 0
    },
    {
      "id": "run-capsule-speed", "scenario": "terrain", "source": "sword2",
      "reference": "самая быстрая капсула игрока на бегу 4,2 м/с по ровному и в гору (тики 60…500) — стопа в махе, около 2,2× скорости бега: замер 5б 9,40 м/с; в трассе толпы SWORD за 3000 тиков — до 12,6 м/с (summary.maxSpeed). Больше 11,9 — капсулы дёргаются, меньше 6,9 — стоят на месте или отстают от позы",
      "entity": "player", "field": "Body.MaxSpeed", "stat": "max", "from": 60, "to": 500, "expected": 9.4, "tolerance": 2.5
    },
    {
      "id": "slope-pelvis-height", "scenario": "terrain", "source": "sword2",
      "reference": "таз игрока на вершине склона (0, 18; рельеф 1,6 м) — капсулы стоят на высоте рельефа под корнем (KinWorld SWORD): наибольшая высота центра таза за тики 0…600 — вершина склона плюс высота таза в клипе бега: замер 5б 2,504 м (без высоты рельефа было бы около 0,95)",
      "entity": "player", "field": "Body.pelvis.Position.Y", "stat": "max", "from": 1, "to": 600, "expected": 2.5, "tolerance": 0.1
    }
  ],
  "views": [
    {
      "id": "capsules-crowd", "title": "32 врага сошлись к игроку (сценарий arena, тик 176) — капсулы тел всех 33 бойцов поверх персонажей (оверлей capsules), камера SWORD за тазом игрока",
      "scenario": "arena", "tick": 176, "overlays": ["capsules"]
    },
    {
      "id": "capsules-close", "title": "игрок бежит в гору к вершине склона (0, 18) (сценарий terrain, тик 400) — крупно: 13 капсул на суставах Manny, левые голубые, правые красные",
      "scenario": "terrain", "tick": 400, "camera": "0.6,0.6,7,0,13.5", "overlays": ["capsules"]
    }
  ],
  "checklist": [
    "`Sword.exe` — F7: поверх Manny и врагов появляются полупрозрачные капсулы тел (таз, торс, голова — жёлтые, левые руки и ноги — голубые, правые — красные); F7 ещё раз — пропадают. В справке F1 — строка «F7 — капсулы тел».",
    "С включёнными капсулами (F7) побегать WASD, покрутить камеру и приблизить колесом: капсулы идут вместе с персонажем без отставания и дрожи — стопы, кисти и голова остаются внутри своих капсул и на бегу, и на повороте, и при `Sword.exe --max-fps 30`.",
    "`Sword.exe --units 32`, F7 — капсулы у всех 33 бойцов, враги сходятся с капсулами; PageUp/PageDown/R — капсулы появляются и пропадают вместе с бойцами, после R стоят сразу на построенных бойцах. Кадр плавный.",
    "Камера следует за тазом игрока (как в SWORD): на бегу и на месте камера идёт ровно, без рывков; тень и зелёное кольцо — под тазом, идут вместе с Manny.",
    "`Sword.exe --overlay capsules` — капсулы видны с первого кадра (как F7). В журнале нет строк `[invariant] нарушен physics.…`."
  ]
}
