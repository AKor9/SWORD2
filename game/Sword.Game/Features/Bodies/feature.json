{
  // Приёмка фичи «Физика и тела» (этап 5) — точки 5а (подсистема Physics, хуки ECS, тело бойца — сочленение из 13
  // кинематических капсул за BodyRef, участник хеша physics, инварианты physics.finite/bodyRefs), 5б (капсулы по позе:
  // форма и постановка при постройке, постановка по позе тика в PrePhysics, инварианты physics.kinematicPose/kinematicSpeed,
  // метрики по вычисляемым полям тела Body.* — Game.Agent.BodyFields), 5в (капсулы на экране и агенту:
  // виды с оверлеем капсул — Sword.exe --overlay capsules; тела сборки мира стоят до первого тика); полный — на 5г: сценарии
  // толпы (бег сквозь 32 врагов), поворота врага клипом, рельефа (склон, ступени вверх и вниз, ухабы), метрики скоростей и
  // высот капсул по замерам, виды крупным планом, бюджеты (тик и стадия PrePhysics с 32 врагами, кадр App без капсул и с
  // капсулами — budgets[].frame.overlays, 5г). После подтверждения пользователя (раздел 12 плана) зафиксирован эталон SWORD2
  // bodies.swreplay — запись сценария terrain, сценарий reference-terrain (README, «Эталон SWORD2»). 7а: сравнения со SWORD сняты
  // (решение 14) — метрики против трасс SWORD (sword-crowd-pelvis-*, sword-terrain-pelvis*) удалены. Формат — FeatureManifest
  // (Sword.Engine.Introspection), исполняет feature.verify (Sword.Headless --feature bodies). Ослабить ожидания — только
  // правкой с сообщением пользователю.
  "format": "sword-feature",
  "version": 1,
  "id": "bodies",
  "title": "Физика и тела (этап 5; 5а — Physics, хуки ECS, тела бойцов за BodyRef; 5б — капсулы по позе; 5в — капсулы на экране и агенту; 5г — рельеф и приёмка)",
  "doc": "README.md",
  "sourceRoots": [
    "engine/Sword.Engine.Physics",
    "engine/Sword.Engine.Ecs/WorldHooks.cs",
    "engine/Sword.Engine.Ecs/Hooks.cs",
    "game/Sword.Game/Bodies",
    "game/Sword.Game.Contracts/BodySegs.cs",
    "game/Sword.Game.Contracts/Components.cs",
    "game/Sword.Game.Contracts/Views.cs",
    "game/Sword.Game/Arena/ArenaSpawn.cs",
    "game/Sword.Game/Arena/ArenaTerrain.cs",
    "game/Sword.Game/GameCore.cs",
    "game/Sword.Game.Agent/PhysicsTools.cs",
    "game/Sword.Game/Bodies/JointSegments.cs",
    "game/Sword.Game.Client/ArenaView.cs",
    "game/Sword.Game.Client/ArenaClient.cs",
    "engine/Sword.Engine.Render/DebugDraw.cs",
    "engine/Sword.Engine.Render/Shaders/common/debug.hlsl",
    "engine/Sword.Engine.Agent.Client/ClientAgent.cs"
  ],
  "requiredModules": ["locomotion"],
  "scenarios": [
    {
      "id": "arena",
      "title": "тела при командах арены: PageUp, до 32, PageDown ×10, R, до 0, PageUp — у каждого бойца своё тело, лишних нет (physics.bodyRefs); построенные и построенные заново бойцы встают по позе постройки без скачка капсул (physics.kinematicSpeed), капсулы на суставах (physics.kinematicPose)",
      "set": ["arena.enemies=10", "combat.enemiesAttack=false"],
      "ticks": 480,
      "commands": [
        { "command": "PlayerCommand", "fields": { "Move": { "X": 1, "Y": 0.5 } }, "from": 0, "to": 240 },
        { "command": "ArenaCommand", "fields": { "Action": "ChangeEnemies", "Enemies": 1 }, "from": 60, "to": 61 },
        { "command": "ArenaCommand", "fields": { "Action": "SetEnemies", "Enemies": 32 }, "from": 120, "to": 121 },
        { "command": "ArenaCommand", "fields": { "Action": "ChangeEnemies", "Enemies": -1 }, "from": 180, "to": 190 },
        { "command": "ArenaCommand", "fields": { "Action": "Reset" }, "from": 300, "to": 301 },
        { "command": "ArenaCommand", "fields": { "Action": "SetEnemies", "Enemies": 0 }, "from": 360, "to": 361 },
        { "command": "ArenaCommand", "fields": { "Action": "ChangeEnemies", "Enemies": 1 }, "from": 420, "to": 421 }
      ],
      "checks": [
        {
          "id": "every-fighter", "title": "у каждого бойца есть тело (BodyRef), других владельцев тел нет", "expect": "always",
          "condition": {
            "all": [
              { "none": { "all": [{ "component": "Fighter" }, { "not": { "component": "BodyRef" } }] } },
              { "none": { "all": [{ "component": "BodyRef" }, { "not": { "component": "Fighter" } }] } }
            ]
          }
        },
        {
          "id": "eleven", "title": "PageUp — тел 12", "expect": "always", "from": 62, "to": 120,
          "condition": { "count": { "component": "BodyRef" }, "equals": 12 }
        },
        {
          "id": "thirty-three", "title": "32 врага — тел 33", "expect": "always", "from": 122, "to": 180,
          "condition": { "count": { "component": "BodyRef" }, "equals": 33 }
        },
        {
          "id": "page-down", "title": "PageDown ×10 — тел 23", "expect": "always", "from": 191, "to": 300,
          "condition": { "count": { "component": "BodyRef" }, "equals": 23 }
        },
        {
          "id": "reset", "title": "R — бойцы построены заново на тех же сущностях, тел по-прежнему 23", "expect": "always", "from": 302, "to": 360,
          "condition": { "count": { "component": "BodyRef" }, "equals": 23 }
        },
        {
          "id": "zero", "title": "0 врагов — одно тело (игрок)", "expect": "always", "from": 362, "to": 420,
          "condition": { "count": { "component": "BodyRef" }, "equals": 1 }
        },
        {
          "id": "page-up-again", "title": "PageUp — тел 2", "expect": "always", "from": 422,
          "condition": { "count": { "component": "BodyRef" }, "equals": 2 }
        }
      ]
    },
    {
      "id": "terrain",
      "title": "рельеф (5г): игрок бежит на склон (0, 18) до вершины 1,6 м, затем на ступенчатую пирамиду (−16, 0: пять ярусов по 12 см) и стоит на верхнем ярусе; шагом спускается по ступеням на запад до земли; бежит через ухабы (0, −18) и встаёт на них — капсулы идут за позой и рельефом под корнем, на суставах (physics.kinematicPose), на кромках ступеней скачет мир бойца, а не капсулы относительно него (physics.kinematicSpeed)",
      "set": ["arena.enemies=0", "sim.seed=1"],
      "ticks": 2800,
      "commands": [
        { "command": "PlayerCommand", "fields": { "Move": { "X": 0, "Y": 1 } }, "from": 0, "to": 520 },
        { "command": "PlayerCommand", "fields": { "Move": { "X": -0.62, "Y": -0.78 } }, "from": 520, "to": 1240 },
        { "command": "PlayerCommand", "fields": { "Move": { "X": -1, "Y": 0 }, "Walk": true }, "from": 1400, "to": 1900 },
        { "command": "PlayerCommand", "fields": { "Move": { "X": 0.784, "Y": -0.621 } }, "from": 1900, "to": 2680 }
      ],
      "checks": [
        {
          "id": "on-slope", "title": "игрок поднялся на склон — ближе 2 м к вершине (0, 18)", "expect": "eventually", "to": 600,
          "condition": { "all": [{ "entity": "player" }, { "field": "Transform.Position.Z", "greaterThan": 16 }, { "field": "Transform.Position.Z", "lessThan": 20 }, { "field": "Transform.Position.X", "greaterThan": -2 }, { "field": "Transform.Position.X", "lessThan": 2 }] }
        },
        {
          "id": "on-steps", "title": "игрок стоит на верхнем ярусе пирамиды: max(|x + 16|, |z|) < 2", "expect": "always", "from": 1300, "to": 1400,
          "condition": { "all": [{ "entity": "player" }, { "field": "Transform.Position.X", "greaterThan": -18 }, { "field": "Transform.Position.X", "lessThan": -14 }, { "field": "Transform.Position.Z", "greaterThan": -2 }, { "field": "Transform.Position.Z", "lessThan": 2 }] }
        },
        {
          "id": "walk-down", "title": "по ступеням спускается шагом, не бегом", "expect": "always", "from": 1420, "to": 1900,
          "condition": { "all": [{ "entity": "player" }, { "field": "LegacyLocomotionState.Run", "equals": false }] }
        },
        {
          "id": "off-steps", "title": "сошёл с пирамиды на землю: x < −22 (нижний ярус — до |x + 16| = 6)", "expect": "eventually", "from": 1800, "to": 1900,
          "condition": { "all": [{ "entity": "player" }, { "field": "Transform.Position.X", "lessThan": -22 }] }
        },
        {
          "id": "on-bumps", "title": "в конце игрок на ухабах — ближе 3 м к (0, −18)", "expect": "atEnd",
          "condition": { "all": [{ "entity": "player" }, { "field": "Transform.Position.X", "greaterThan": -3 }, { "field": "Transform.Position.X", "lessThan": 3 }, { "field": "Transform.Position.Z", "greaterThan": -21 }, { "field": "Transform.Position.Z", "lessThan": -15 }] }
        }
      ]
    },
    {
      "id": "crowd",
      "title": "32 врага, игрок бежит сквозь кольцо, толпа бежит следом (Sword.exe --units 32 --move 1,0) — 33 тела по позе каждый тик; бюджеты тика и кадра",
      "set": ["arena.enemies=32", "combat.enemiesAttack=false"],
      "ticks": 900,
      "commands": [{ "command": "PlayerCommand", "fields": { "Move": { "X": 1, "Y": 0 } }, "from": 0, "to": 900 }],
      "checks": [
        {
          "id": "thirty-three", "title": "33 тела — у каждого бойца, других владельцев нет", "expect": "always",
          "condition": {
            "all": [
              { "count": { "component": "BodyRef" }, "equals": 33 },
              { "none": { "all": [{ "component": "Fighter" }, { "not": { "component": "BodyRef" } }] } },
              { "none": { "all": [{ "component": "BodyRef" }, { "not": { "component": "Fighter" } }] } }
            ]
          }
        },
        {
          "id": "chase-run", "title": "толпа бежит за игроком: больше половины врагов — клипом бега", "expect": "eventually", "to": 300,
          "condition": { "count": { "all": [{ "component": "EnemyTag" }, { "field": "LegacyLocomotionState.Run", "equals": true }] }, "greaterThan": 16 }
        },
        {
          "id": "pushes", "title": "корни толпы сталкиваются (пары корней разрешаются) — капсулы идут за сдвинутым корнем", "expect": "eventually",
          "condition": { "exists": { "all": [{ "component": "EnemyTag" }, { "field": "RootContacts.Contacts", "greaterThan": 0 }] } }
        }
      ]
    },
    {
      "id": "turn",
      "title": "поворот врага на месте клипом (командой врагу EnemyCommand, начало сценария turn фичи enemies): стоя 90° влево, вправо, разворот, меньше 45° — капсулы идут за позой клипа поворота",
      "set": ["arena.enemies=1", "combat.enemiesAttack=false"],
      "ticks": 720,
      "commands": [
        { "command": "EnemyCommand", "fields": { "Slot": 1, "FacingGoal": 0.8123 }, "from": 0, "to": 60 },
        { "command": "EnemyCommand", "fields": { "Slot": 1, "FacingGoal": 2.4 }, "from": 60, "to": 240 },
        { "command": "EnemyCommand", "fields": { "Slot": 1, "FacingGoal": 1.1 }, "from": 240, "to": 420 },
        { "command": "EnemyCommand", "fields": { "Slot": 1, "FacingGoal": 4.2 }, "from": 420, "to": 660 },
        { "command": "EnemyCommand", "fields": { "Slot": 1, "FacingGoal": 4.7 }, "from": 660, "to": 720 }
      ],
      "checks": [
        {
          "id": "turn-clip", "title": "курс-цель +1,6 рад стоя — поворот на месте клипом", "expect": "eventually", "from": 61, "to": 240,
          "condition": { "all": [{ "entity": "enemy 1" }, { "field": "AnimatorAction.Kind", "equals": "Turn" }, { "field": "AnimatorAction.YawDelta", "greaterThan": 0 }] }
        },
        {
          "id": "turn-180", "title": "+3,1 рад — разворот клипом дошёл до цели 4,2 рад", "expect": "eventually", "from": 600, "to": 660,
          "condition": { "all": [{ "entity": "enemy 1" }, { "field": "Transform.Facing", "greaterThan": 4.19 }, { "field": "Transform.Facing", "lessThan": 4.21 }] }
        }
      ]
    },
    {
      "id": "reference",
      "title": "эталон SWORD2 enemies (запись сценария crowd-commands фичи enemies: толпа, команды арены по ходу, рельеф холмов по пути к колонне): хеши участника physics каждого тика",
      "replay": "tests/reference/replays/enemies.swreplay",
      "checks": [
        {
          "id": "every-fighter", "title": "у каждого бойца есть тело (BodyRef)", "expect": "always",
          "condition": { "none": { "all": [{ "component": "Fighter" }, { "not": { "component": "BodyRef" } }] } }
        },
        {
          "id": "end-33", "title": "в конце 33 тела", "expect": "eventually", "from": 2990,
          "condition": { "count": { "component": "BodyRef" }, "equals": 33 }
        }
      ]
    },
    {
      "id": "reference-terrain",
      "title": "эталон SWORD2 bodies (после подтверждения этапа 5): запись сценария terrain — склон, ступени вверх бегом и вниз шагом, стойка на ярусе, ухабы (хеши участников animation, ecs, physics каждого тика)",
      "replay": "tests/reference/replays/bodies.swreplay",
      "checks": [
        {
          "id": "one-body", "title": "одно тело — у игрока, других владельцев нет", "expect": "always",
          "condition": {
            "all": [
              { "count": { "component": "BodyRef" }, "equals": 1 },
              { "none": { "all": [{ "component": "Fighter" }, { "not": { "component": "BodyRef" } }] } }
            ]
          }
        },
        {
          "id": "on-bumps", "title": "в конце игрок на ухабах — ближе 3 м к (0, −18)", "expect": "atEnd",
          "condition": { "all": [{ "entity": "player" }, { "field": "Transform.Position.X", "greaterThan": -3 }, { "field": "Transform.Position.X", "lessThan": 3 }, { "field": "Transform.Position.Z", "greaterThan": -21 }, { "field": "Transform.Position.Z", "lessThan": -15 }] }
        }
      ]
    }
  ],
  "invariants": ["ecs.*", "physics.*", "animation.*", "locomotion.poses", "arena.slots", "movement.rootOverlap"],
  "metrics": [
    {
      "id": "run-capsule-speed", "scenario": "terrain",
      "reference": "самая быстрая капсула игрока на бегу 4,2 м/с по ровному и в гору (тики 60…500) — стопа в махе, около 2,2× скорости бега: замер 5б 9,40 м/с. Больше 11,9 — капсулы дёргаются, меньше 6,9 — стоят на месте или отстают от позы",
      "entity": "player", "field": "Body.MaxSpeed", "stat": "max", "from": 60, "to": 500, "expected": 9.4, "tolerance": 2.5
    },
    {
      "id": "slope-pelvis-height", "scenario": "terrain",
      "reference": "таз игрока на вершине склона (0, 18; рельеф 1,6 м) — капсулы стоят на высоте рельефа под корнем (KinWorld SWORD): наибольшая высота центра таза за тики 0…600 — вершина склона плюс высота таза в клипе бега: замер 5б 2,504 м (без высоты рельефа было бы около 0,95)",
      "entity": "player", "field": "Body.pelvis.Position.Y", "stat": "max", "from": 1, "to": 600, "expected": 2.5, "tolerance": 0.1
    },
    {
      "id": "steps-top-foot", "scenario": "terrain",
      "reference": "игрок стоит на верхнем ярусе пирамиды (5 × 12 см = 0,6 м; тики 1300…1400) — капсула левой стопы на ярусе, а не в нём и не над ним: средняя высота её центра — замер 5г 0,659 м (на ровной земле стоя — 0,051: ярус + 0,6 м); меньше 0,63 — стопа в ступени, больше 0,67 — висит",
      "entity": "player", "field": "Body.foot.l.Position.Y", "stat": "mean", "from": 1300, "to": 1400, "expected": 0.65, "tolerance": 0.02
    },
    {
      "id": "step-edge-speed", "scenario": "terrain",
      "reference": "шагом вниз по ступеням (тики 1420…1900): на кромке мир бойца (высота рельефа под корнем, KinWorld SWORD) опускается на 12 см за тик — капсулы получают скачок 0,12 · 120 = 14,4 м/с поверх шага; самая быстрая капсула — замер 5г 15,13 м/с. Сглаживания высоты тела на ступенях (постановка стоп) пока нет — этап 9; больше 16,6 — скачок больше ступени или дрожь, меньше 13,6 — кромки сглажены (поведение изменилось — пересмотреть метрику)",
      "entity": "player", "field": "Body.MaxSpeed", "stat": "max", "from": 1420, "to": 1900, "expected": 15.1, "tolerance": 1.5
    },
    {
      "id": "idle-capsule-speed", "scenario": "terrain",
      "reference": "игрок стоит на верхнем ярусе (тики 1340…1400; остановился на 1240) — капсулы почти неподвижны (стойка): средняя за окно скорость самой быстрой капсулы — замер 5г 0,38 м/с (наибольшая 1,27); больше 0,68 — капсулы дрожат на месте",
      "entity": "player", "field": "Body.MaxSpeed", "stat": "mean", "from": 1340, "to": 1400, "expected": 0.38, "tolerance": 0.3
    },
    {
      "id": "crowd-capsule-speed", "scenario": "crowd",
      "reference": "враг 1 в толпе из 32 бежит за игроком (подход до 3,2 м/с, толчки корней соседей — законный сдвиг мира бойца): самая быстрая его капсула за 900 тиков — замер 5г 7,79 м/с (≈ 2,4× скорости бега врага, как у игрока 9,4 при 4,2); больше 10,3 — капсулы дёргаются в толкотне, меньше 5,3 — не идут за позой. Число — этой расстановки (зерно сценария): на зёрнах 2, 3, 5 — 10,1, 7,2, 9,3; на зерне 4 — 35,4 на тике 1 (враг 1 построен внахлёст, ResolveRoots выталкивает корень — README, «Ограничения»)",
      "entity": "enemy 1", "field": "Body.MaxSpeed", "stat": "max", "from": 1, "to": 900, "expected": 7.8, "tolerance": 2.5
    },
    {
      "id": "turn-angular-speed", "scenario": "turn",
      "reference": "поворот врага на месте клипом (тики 61…720: 90° влево, вправо, разворот, меньше 45° без клипа): наибольшая угловая скорость капсулы — замер 5г 18,0 рад/с на развороте (тик 497: предплечье в махе клипа Turn180; 90° — 13,0 и 10,6, без клипа — 2,7, стоя — 0,8); больше 24 — капсулы крутит рывками, меньше 12 — не идут за позой клипа поворота",
      "entity": "enemy 1", "field": "Body.MaxAngularSpeed", "stat": "max", "from": 61, "to": 720, "expected": 18, "tolerance": 6
    }
  ],
