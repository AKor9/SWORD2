{
  // Приёмка фичи «Враги и ИИ» (этап 4) — начата на точке 4а (спаун и команды арены), дополнена на 4б (ИИ: подход,
  // окружение, погоня), 4в (столкновения бойцов: толпа, игрок расталкивает её, инвариант movement.rootOverlap) и 4г
  // (поворот врага на месте клипом командой врагу); полный — на 4д: толпа с командами арены по ходу и колонной (сценарий
  // crowd-commands, до 7а — sword-crowd), бюджеты на 32 врагах (тик, стадии, байты, кадр App). После подтверждения
  // пользователя (раздел 12 плана) зафиксирован эталон SWORD2 enemies.swreplay — сценарий reference. 7а: сравнения со SWORD
  // сняты (решение 14) — метрики против трасс SWORD удалены, сценарий трассы толпы переименован. Формат — FeatureManifest
  // (Sword.Engine.Introspection), исполняет feature.verify (Sword.Headless --feature enemies). Ослабить ожидания — только
  // правкой с сообщением пользователю.
  "format": "sword-feature",
  "version": 1,
  "id": "enemies",
  "title": "Враги и ИИ (этап 4; точки 4а — спаун и команды арены, 4б — ИИ врагов, 4в — столкновения бойцов, 4г — поворот на месте, 4д — толпа с командами арены и приёмка)",
  "doc": "README.md",
  "sourceRoots": [
    "game/Sword.Game/Arena",
    "game/Sword.Game/Ai",
    "game/Sword.Game/Movement",
    "game/Sword.Game/Animation/AnimatorAction.cs",
    "game/Sword.Game/GameCore.cs",
    "game/Sword.Game.Contracts/Components.cs",
    "game/Sword.Game.Client/ArenaInput.cs",
    "game/Sword.Game.Agent/SwordAgent.cs"
  ],
  "requiredModules": ["locomotion"],
  "scenarios": [
    {
      "id": "ring",
      "title": "10 врагов из кольца вокруг игрока сходятся к нему бегом (Sword.exe без ключей)",
      "set": ["arena.enemies=10", "combat.enemiesAttack=false"],
      "ticks": 600,
      "checks": [
        {
          "id": "ten", "title": "врагов 10, бойцов 11", "expect": "always",
          "condition": {
            "all": [
              { "count": { "component": "EnemyTag" }, "equals": 10 },
              { "count": { "component": "Fighter" }, "equals": 11 },
              { "resource": "ArenaState.Enemies", "equals": 10 }
            ]
          }
        },
        {
          "id": "run-in", "title": "враги бегут к игроку (кольцо спауна 5–9 м, подход до 3,2 м/с)", "expect": "eventually", "to": 120,
          "condition": { "exists": { "all": [{ "component": "EnemyTag" }, { "field": "LegacyLocomotionState.Run", "equals": true }] } }
        },
        {
          "id": "ring", "title": "не дальше 9 м от игрока в центре (кольцо спауна, дальше — только ближе)", "expect": "always",
          "condition": {
            "none": {
              "all": [
                { "component": "EnemyTag" },
                {
                  "any": [
                    { "field": "Transform.Position.X", "greaterThan": 9 }, { "field": "Transform.Position.X", "lessThan": -9 },
                    { "field": "Transform.Position.Z", "greaterThan": 9 }, { "field": "Transform.Position.Z", "lessThan": -9 }
                  ]
                }
              ]
            }
          }
        },
        {
          "id": "approach", "title": "все враги подошли к игроку ближе 2,5 м", "expect": "eventually",
          "condition": { "none": { "all": [{ "component": "EnemyTag" }, { "field": "EnemyAiTerms.Distance", "greaterThan": 2.5 }] } }
        },
        {
          "id": "loco-clip", "title": "у врагов идёт локомоция клипами (бег, шаг, стойка — не поза привязки)", "expect": "always",
          "condition": { "none": { "all": [{ "component": "EnemyTag" }, { "field": "LegacyLocomotionState.Clip", "lessThan": 0 }] } }
        }
      ]
    },
    {
      "id": "commands",
      "title": "команды арены по ходу: PageUp, до 32, PageDown ×10, R (игрок отбежал), до 0",
      "set": ["arena.enemies=10", "combat.enemiesAttack=false"],
      "ticks": 420,
      "commands": [
        { "command": "PlayerCommand", "fields": { "Move": { "X": 1, "Y": 0.5 } }, "from": 0, "to": 240 },
        { "command": "ArenaCommand", "fields": { "Action": "ChangeEnemies", "Enemies": 1 }, "from": 60, "to": 61 },
        { "command": "ArenaCommand", "fields": { "Action": "SetEnemies", "Enemies": 40 }, "from": 120, "to": 121 },
        { "command": "ArenaCommand", "fields": { "Action": "ChangeEnemies", "Enemies": -1 }, "from": 180, "to": 190 },
        { "command": "ArenaCommand", "fields": { "Action": "Reset" }, "from": 300, "to": 301 },
        { "command": "ArenaCommand", "fields": { "Action": "SetEnemies", "Enemies": 0 }, "from": 360, "to": 361 }
      ],
      "checks": [
        {
          "id": "page-up", "title": "PageUp — 11 врагов", "expect": "always", "from": 62, "to": 120,
          "condition": { "all": [{ "count": { "component": "EnemyTag" }, "equals": 11 }, { "resource": "ArenaState.Enemies", "equals": 11 }] }
        },
        {
          "id": "clamp-32", "title": "40 — упирается в 32", "expect": "always", "from": 122, "to": 180,
          "condition": { "all": [{ "count": { "component": "EnemyTag" }, "equals": 32 }, { "count": { "component": "Fighter" }, "equals": 33 }] }
        },
        {
          "id": "page-down", "title": "PageDown ×10 — 22 врага, ушли последние места", "expect": "always", "from": 191, "to": 300,
          "condition": {
            "all": [
              { "count": { "component": "EnemyTag" }, "equals": 22 },
              { "none": { "all": [{ "component": "EnemyTag" }, { "field": "FighterSlot.Index", "greaterThan": 22 }] } }
            ]
          }
        },
        {
          "id": "ran-away", "title": "перед сбросом игрок далеко от центра", "expect": "eventually", "to": 300,
          "condition": { "all": [{ "entity": "player" }, { "field": "Transform.Position.X", "greaterThan": 5 }] }
        },
        {
          "id": "reset", "title": "R — игрок в центре, врагов по-прежнему 22, кольцом вокруг центра", "expect": "always", "from": 302, "to": 360,
          "condition": {
            "all": [
              { "all": [{ "entity": "player" }, { "field": "Transform.Position.X", "equals": 0 }, { "field": "Transform.Position.Z", "equals": 0 }] },
              { "count": { "component": "EnemyTag" }, "equals": 22 },
              {
                "none": {
                  "all": [
                    { "component": "EnemyTag" },
                    {
                      "any": [
                        { "field": "Transform.Position.X", "greaterThan": 9 }, { "field": "Transform.Position.X", "lessThan": -9 },
                        { "field": "Transform.Position.Z", "greaterThan": 9 }, { "field": "Transform.Position.Z", "lessThan": -9 }
                      ]
                    }
                  ]
                }
              }
            ]
          }
        },
        {
          "id": "empty", "title": "0 — остался один игрок", "expect": "always", "from": 362,
          "condition": { "all": [{ "count": { "component": "Fighter" }, "equals": 1 }, { "count": { "component": "EnemyTag" }, "equals": 0 }] }
        }
      ]
    },
    {
      "id": "surround",
      "title": "10 врагов подходят и окружают стоящего игрока на ~1,8 м, покачиваются, не бегут и не слипаются",
      "set": ["arena.enemies=10", "combat.enemiesAttack=false"],
      "ticks": 1200,
      "checks": [
        {
          "id": "approach", "title": "за 4 с все враги ближе 2,5 м", "expect": "eventually", "to": 480,
          "condition": { "none": { "all": [{ "component": "EnemyTag" }, { "field": "EnemyAiTerms.Distance", "greaterThan": 2.5 }] } }
        },
        {
          "id": "ring", "title": "с 4 с — кольцо 1,2…2,6 м вокруг игрока (KeepDistance 1,8; расхождение отодвигает)", "expect": "always", "from": 480,
          "condition": {
            "none": {
              "all": [
                { "component": "EnemyTag" },
                { "any": [{ "field": "EnemyAiTerms.Distance", "lessThan": 1.2 }, { "field": "EnemyAiTerms.Distance", "greaterThan": 2.6 }] }
              ]
            }
          }
        },
        {
          "id": "stopped", "title": "с 4 с — к игроку не бегут: подход −1,5…2 м/с, клип не бег", "expect": "always", "from": 480,
          "condition": {
            "none": {
              "all": [
                { "component": "EnemyTag" },
                {
                  "any": [
                    { "field": "EnemyAiTerms.ApproachSpeed", "greaterThan": 2 }, { "field": "EnemyAiTerms.ApproachSpeed", "lessThan": -1.5 },
                    { "field": "LegacyLocomotionState.Run", "equals": true }
                  ]
                }
              ]
            }
          }
        },
        {
          "id": "apart", "title": "с 4 с — у врага не больше 3 соседей ближе 1,4 м (расхождение)", "expect": "always", "from": 480,
          "condition": { "none": { "all": [{ "component": "EnemyTag" }, { "field": "EnemyAiTerms.Neighbours", "greaterThan": 3 }] } }
        },
        {
          "id": "gaze", "title": "точка взгляда каждого врага — игрок в центре", "expect": "always", "from": 1,
          "condition": {
            "none": {
              "all": [
                { "component": "EnemyTag" },
                {
                  "any": [
                    { "field": "GazeTarget.Has", "equals": false },
                    { "field": "GazeTarget.Point.X", "notEquals": 0 }, { "field": "GazeTarget.Point.Z", "notEquals": 0 }
                  ]
                }
              ]
            }
          }
        },
        {
          "id": "ring-end", "title": "в конце — 10 врагов в 1,2…2,5 м от игрока", "expect": "atEnd",
          "condition": {
            "all": [
              { "max": "EnemyAiTerms.Distance", "where": { "component": "EnemyTag" }, "lessThan": 2.5 },
              { "min": "EnemyAiTerms.Distance", "where": { "component": "EnemyTag" }, "greaterThan": 1.2 },
              { "count": { "component": "EnemyTag" }, "equals": 10 }
            ]
          }
        }
      ]
    },
    {
      "id": "chase",
      "title": "игрок убегает 4 с и встаёт — враги бегут следом и снова окружают",
      "set": ["arena.enemies=10", "combat.enemiesAttack=false"],
      "ticks": 1500,
      "commands": [{ "command": "PlayerCommand", "fields": { "Move": { "X": 1, "Y": 0 } }, "from": 0, "to": 480 }],
      "checks": [
        {
          "id": "ran", "title": "игрок убежал дальше 15 м", "expect": "eventually", "to": 480,
          "condition": { "all": [{ "entity": "player" }, { "field": "Transform.Position.X", "greaterThan": 15 }] }
        },
        {
          "id": "chase-run", "title": "враги бегут следом", "expect": "eventually", "from": 240, "to": 480,
          "condition": { "exists": { "all": [{ "component": "EnemyTag" }, { "field": "LegacyLocomotionState.Run", "equals": true }] } }
        },
        {
          "id": "caught-up", "title": "после остановки все враги снова ближе 2,5 м", "expect": "eventually", "from": 480,
          "condition": { "none": { "all": [{ "component": "EnemyTag" }, { "field": "EnemyAiTerms.Distance", "greaterThan": 2.5 }] } }
        }
      ]
    },
    {
      "id": "crowd",
      "title": "32 врага, игрок бежит сквозь кольцо (Sword.exe --units 32 --move 1,0)",
      "set": ["arena.enemies=32", "combat.enemiesAttack=false"],
      "ticks": 900,
      "commands": [{ "command": "PlayerCommand", "fields": { "Move": { "X": 1, "Y": 0 } }, "from": 0, "to": 900 }],
      "checks": [
        {
          "id": "thirty-two", "title": "32 врага на местах 1…32", "expect": "always",
          "condition": { "all": [{ "count": { "component": "EnemyTag" }, "equals": 32 }, { "max": "FighterSlot.Index", "equals": 32 }] }
        },
        {
          "id": "chase-run", "title": "толпа бежит за игроком: больше половины врагов — клипом бега", "expect": "eventually", "to": 300,
          "condition": { "count": { "all": [{ "component": "EnemyTag" }, { "field": "LegacyLocomotionState.Run", "equals": true }] }, "greaterThan": 16 }
        }
      ]
    },
    {
      "id": "push",
      "title": "32 врага обступили стоящего игрока, игрок бежит в толпу: упирается, расталкивает её и протискивается (Sword.exe --units 32, через 5 с — D)",
      "set": ["arena.enemies=32", "combat.enemiesAttack=false"],
      "ticks": 1080,
      "commands": [{ "command": "PlayerCommand", "fields": { "Move": { "X": 1, "Y": 0 } }, "from": 600, "to": 1080 }],
      "checks": [
        {
          "id": "crowd-contacts", "title": "пока игрок стоит, враги толпы упираются друг в друга (пары корней разрешаются)", "expect": "eventually", "from": 300, "to": 600,
          "condition": { "exists": { "all": [{ "component": "EnemyTag" }, { "field": "RootContacts.Contacts", "greaterThan": 0 }] } }
        },
        {
          "id": "blocked", "title": "разогнавшись, игрок упирается в толпу: скорость вперёд падает ниже 1 м/с", "expect": "eventually", "from": 620, "to": 780,
          "condition": { "all": [{ "entity": "player" }, { "field": "RootVelocity.Value.X", "lessThan": 1 }] }
        },
        {
          "id": "pushes", "title": "игрок толкает врага перед собой (сдвиг парой с игроком — вперёд, по +X)", "expect": "eventually", "from": 600, "to": 780,
          "condition": { "exists": { "all": [{ "component": "EnemyTag" }, { "field": "RootContacts.FromPlayer.X", "greaterThan": 0 }] } }
        },
        {
          "id": "through", "title": "игрок протискивается сквозь толпу — дальше 5 м от центра", "expect": "eventually", "from": 600,
          "condition": { "all": [{ "entity": "player" }, { "field": "Transform.Position.X", "greaterThan": 5 }] }
        },
        {
          "id": "not-inside", "title": "толпа не проходит сквозь игрока: ни один враг не ближе 0,68 м (два радиуса корня 0,7 − допуск 0,02)", "expect": "always", "from": 1,
          "condition": { "none": { "all": [{ "component": "EnemyTag" }, { "field": "EnemyAiTerms.Distance", "lessThan": 0.68 }] } }
        }
      ]
    },
    {
      "id": "turn",
      "title": "поворот врага на месте (4г): курс-цель врага 1 скачет командой врагу (EnemyCommand): стоя на 90° влево, вправо, разворот, меньше 45°, поворот прерван ходьбой, поворот на ходу, остановка с отставшим курсом (1440 тиков)",
      "set": ["arena.enemies=1", "combat.enemiesAttack=false"],
      "ticks": 1440,
      "commands": [
        { "command": "EnemyCommand", "fields": { "Slot": 1, "FacingGoal": 0.8123 }, "from": 0, "to": 60 },
        { "command": "EnemyCommand", "fields": { "Slot": 1, "FacingGoal": 2.4 }, "from": 60, "to": 240 },
        { "command": "EnemyCommand", "fields": { "Slot": 1, "FacingGoal": 1.1 }, "from": 240, "to": 420 },
        { "command": "EnemyCommand", "fields": { "Slot": 1, "FacingGoal": 4.2 }, "from": 420, "to": 660 },
        { "command": "EnemyCommand", "fields": { "Slot": 1, "FacingGoal": 4.7 }, "from": 660, "to": 720 },
        { "command": "EnemyCommand", "fields": { "Slot": 1, "FacingGoal": 6.4 }, "from": 720, "to": 750 },
        { "command": "EnemyCommand", "fields": { "Slot": 1, "Velocity": { "X": -1.1, "Y": -1.1 }, "FacingGoal": 6.4 }, "from": 750, "to": 900 },
        { "command": "EnemyCommand", "fields": { "Slot": 1, "Velocity": { "X": -1.1, "Y": -1.1 }, "FacingGoal": 5.4 }, "from": 900, "to": 1000 },
        { "command": "EnemyCommand", "fields": { "Slot": 1, "FacingGoal": 8 }, "from": 1000, "to": 1150 },
        { "command": "EnemyCommand", "fields": { "Slot": 1, "FacingGoal": 7.2 }, "from": 1150, "to": 1300 },
        { "command": "EnemyCommand", "fields": { "Slot": 1, "Velocity": { "X": 0.2, "Y": 0.1 }, "FacingGoal": 9.5 }, "from": 1300, "to": 1440 }
      ],
      "checks": [
        {
          "id": "turn-clip", "title": "курс-цель +1,6 рад стоя — поворот на месте клипом, курс ведёт yaw клипа", "expect": "eventually", "from": 61, "to": 240,
          "condition": { "all": [{ "entity": "enemy 1" }, { "field": "AnimatorAction.Kind", "equals": "Turn" }, { "field": "AnimatorAction.YawDelta", "greaterThan": 0 }] }
        },
        {
          "id": "turn-left-done", "title": "поворот влево дошёл до цели 2,4 рад", "expect": "eventually", "from": 200, "to": 240,
          "condition": { "all": [{ "entity": "enemy 1" }, { "field": "Transform.Facing", "greaterThan": 2.39 }, { "field": "Transform.Facing", "lessThan": 2.41 }] }
        },
        {
          "id": "turn-right", "title": "−1,3 рад — поворот клипом вправо (yaw клипа ведёт курс вниз)", "expect": "eventually", "from": 241, "to": 420,
          "condition": { "all": [{ "entity": "enemy 1" }, { "field": "AnimatorAction.Kind", "equals": "Turn" }, { "field": "AnimatorAction.YawDelta", "lessThan": 0 }] }
        },
        {
          "id": "turn-180-done", "title": "+3,1 рад — разворот клипом дошёл до цели 4,2 рад", "expect": "eventually", "from": 600, "to": 660,
          "condition": { "all": [{ "entity": "enemy 1" }, { "field": "Transform.Facing", "greaterThan": 4.19 }, { "field": "Transform.Facing", "lessThan": 4.21 }] }
        },
        {
          "id": "idle-rate", "title": "+0,5 рад (меньше 45°) — без клипа, контроллером 2,5 рад/с", "expect": "always", "from": 661, "to": 720,
          "condition": { "all": [{ "entity": "enemy 1" }, { "field": "AnimatorAction.Kind", "equals": "None" }] }
        },
        {
          "id": "walk-cancels", "title": "пошёл во время поворота — клип гаснет без yaw (курс доворачивает контроллер)", "expect": "eventually", "from": 750, "to": 800,
          "condition": {
            "all": [
              { "entity": "enemy 1" }, { "field": "AnimatorAction.Kind", "equals": "Turn" }, { "field": "AnimatorMotion.Moving", "equals": true },
              { "field": "AnimatorAction.YawDelta", "equals": 0 }
            ]
          }
        },
        {
          "id": "walking-no-clip", "title": "на ходу — поворот без клипа", "expect": "always", "from": 800, "to": 1000,
          "condition": { "all": [{ "entity": "enemy 1" }, { "field": "AnimatorAction.Kind", "equals": "None" }] }
        },
        {
          "id": "player-agile", "title": "у игрока (Agile) действий слоя нет — поворот клипом только у врагов (с 6б слой у игрока есть, пустой)", "expect": "always",
          "condition": { "none": { "all": [{ "component": "PlayerTag" }, { "not": { "field": "AnimatorAction.Kind", "equals": "None" } }] } }
        }
      ]
    },
    {
      "id": "crowd-commands",
      "title": "толпа с командами арены (4д; до 7а — sword-crowd): 12 врагов сходятся к стоящему игроку; PageUp ×2 и 16; игрок разворачивается взглядом, пробегает сквозь кольцо, бегает кругами, уходит шагом; PageDown ×3 и PageUp ×3 (те же места заново); бег по диагонали, R, бег в сторону (сторона ходьбы переживает сброс); бег к колонне 0 — толпа прижимается к ней; у колонны — 32 врага (3000 тиков)",
      "set": ["arena.enemies=12", "sim.seed=1", "combat.enemiesAttack=false"],
      "ticks": 3000,
      "commands": [
        { "command": "PlayerCommand", "fields": { "Move": { "X": 0, "Y": 0 }, "HasGaze": true, "Gaze": { "X": 10, "Y": 0, "Z": 0 } }, "from": 480, "to": 600 },
        { "command": "PlayerCommand", "fields": { "Move": { "X": 1, "Y": 0 }, "HasGaze": true, "Gaze": { "X": 30, "Y": 0, "Z": 0 } }, "from": 600, "to": 780 },
        { "command": "PlayerCommand", "fields": { "Move": { "X": 0, "Y": 1 } }, "from": 780, "to": 825 },
        { "command": "PlayerCommand", "fields": { "Move": { "X": 1, "Y": 1 } }, "from": 825, "to": 870 },
        { "command": "PlayerCommand", "fields": { "Move": { "X": 1, "Y": 0 } }, "from": 870, "to": 915 },
        { "command": "PlayerCommand", "fields": { "Move": { "X": 1, "Y": -1 } }, "from": 915, "to": 960 },
        { "command": "PlayerCommand", "fields": { "Move": { "X": 0, "Y": -1 } }, "from": 960, "to": 1005 },
        { "command": "PlayerCommand", "fields": { "Move": { "X": -1, "Y": -1 } }, "from": 1005, "to": 1050 },
        { "command": "PlayerCommand", "fields": { "Move": { "X": -1, "Y": 0 } }, "from": 1050, "to": 1095 },
        { "command": "PlayerCommand", "fields": { "Move": { "X": -1, "Y": 1 } }, "from": 1095, "to": 1140 },
        { "command": "PlayerCommand", "fields": { "Move": { "X": -1, "Y": 0 }, "Walk": true, "HasGaze": true, "Gaze": { "X": -30, "Y": 0, "Z": 0 } }, "from": 1140, "to": 1320 },
        { "command": "PlayerCommand", "fields": { "Move": { "X": 1, "Y": 1 }, "HasGaze": true, "Gaze": { "X": 0, "Y": 0, "Z": 300 } }, "from": 1320, "to": 1400 },
        { "command": "PlayerCommand", "fields": { "Move": { "X": 0.454, "Y": 0.891 } }, "from": 1400, "to": 1470 },
