{
  // Приёмка фичи «Бой»: сценарии дуэли (удары игрока командами до смерти врага), толпы 32 бьющих врагов против неуязвимого
  // игрока (игрок бьёт без перерыва и поворачивается — бюджеты тика, стадий боя, байтов и кадра App), смерти игрока,
  // кровопотери, возрождения через 8 с, смены меча (T и «взять меч N» — EquipWeapon), рывка сквозь удар, ручки «урон» посреди
  // прогона (TuningCommand), мирных врагов, попаданий до смерти по частям тела, темпа ударов ИИ, рывка стоя. Сравнений со SWORD
  // нет (решение 14): сценарии — со своими проверками.
  // Урон, смерть, реакции, возрождение: дуэль (удары игрока командами до смерти врага, урон по формуле, 3–5 попаданий), смерть
  // стоящего игрока от ударов ИИ (замер, команды не действуют, враги не бьют), смерть от кровопотери (проба удара командой
  // StrikeProbe), возрождение ровно через 8 с (смертельный укол пробой), рывок сквозь удар (касание есть, попадания нет);
  // инварианты combat.health, combat.dead, combat.hits, combat.respawn.
  // Удар и рывок: удар, связка с буфером и снимком позы, укол, удар на бегу без замедления и обрезка хвоста, рывок (прибавка
  // без последствий для хода), удар из рывка, удар ИИ по таймеру и мирные враги (combat.enemiesAttack=false), инвариант
  // combat.control.
  // Подготовка и оружие: меч в руке у каждого бойца (враг — случайный меч пака новой выборкой потока спауна, игрок —
  // combat.playerWeapon), инвентарь игрока и T (команда арены NextWeapon), клинок каждого тика (Blade: на кисти, прошлое —
  // прошлый тик, смена меча — без прохода), инварианты combat.blade и combat.weapons, слой действий у всех бойцов
  // (animation.actions), вид с оверлеем клинков. Индексы мечей — пака контента (по алфавиту: combat_sword 0, katana 1,
  // katana_v2 2, powerful_sword 3, sword_1h 4, sword_dss 5). Формат — FeatureManifest (Sword.Engine.Introspection), исполняет
  // feature.verify (Sword.Headless --feature combat).
  "format": "sword-feature",
  "version": 1,
  "id": "combat",
  "title": "Бой: подготовка и оружие (команды арены в Begin, мечи, инвентарь и T, клинок каждого тика, таблица ударов); удар, связка, укол, рывок, удар ИИ; урон, смерть, реакции, возрождение; причинность; HUD, инвентарь, ручки, F3",
  "doc": "README.md",
  "sourceRoots": [
    "game/Sword.Game/Combat",
    "game/Sword.Game.Contracts/Combat.cs",
    "game/Sword.Game.Contracts/Damage.cs",
    "game/Sword.Game/Animation/Flinch.cs",
    "engine/Sword.Engine.Geometry/Segments.cs",
    "game/Sword.Game.Data/WeaponMesh.cs",
    "game/Sword.Game/Arena/ArenaCommandSystem.cs",
    "game/Sword.Game/Arena/ArenaSpawn.cs",
    "game/Sword.Game/Animation/CharacterAssets.cs",
    "game/Sword.Game.Agent/CombatTools.cs",
    "game/Sword.Game.Client/ArenaView.cs",
    "game/Sword.Game.Client/ArenaClient.cs",
    "engine/Sword.Engine.Render/SkinnedMeshes.cs",
    "engine/Sword.Engine.Render/DebugDraw.cs"
  ],
  "requiredModules": ["locomotion"],
  "scenarios": [
    {
      "id": "weapons",
      "title": "16 врагов сходятся к игроку в центре: мечи в руках у всех, у врагов разные; T на тике 60 — sword_1h → sword_dss; R на тике 150 — враги заново со своими мечами, игрок — с мечом инвентаря; T на тике 200 — по кругу к первому (combat_sword); «взять меч 3» (инвентарь: 3 или щелчок — команда арены EquipWeapon) на тике 220 — katana_v2",
      "set": ["arena.enemies=16"],
      "ticks": 260,
      "commands": [
        { "command": "ArenaCommand", "fields": { "Action": "NextWeapon" }, "from": 60, "to": 61 },
        { "command": "ArenaCommand", "fields": { "Action": "Reset" }, "from": 150, "to": 151 },
        { "command": "ArenaCommand", "fields": { "Action": "NextWeapon" }, "from": 200, "to": 201 },
        { "command": "ArenaCommand", "fields": { "Action": "EquipWeapon", "Weapon": 2 }, "from": 220, "to": 221 }
      ],
      "checks": [
        {
          "id": "every-fighter", "title": "у каждого бойца меч (WeaponSlot) и клинок (Blade), поставленный этим мечом", "expect": "always",
          "condition": {
            "all": [
              { "none": { "all": [{ "component": "Fighter" }, { "not": { "component": "WeaponSlot" } }] } },
              { "none": { "all": [{ "component": "Fighter" }, { "not": { "component": "Blade" } }] } },
              { "none": { "all": [{ "component": "Fighter" }, { "field": "Blade.Weapon", "equals": -1 }] } }
            ]
          }
        },
        {
          "id": "different", "title": "у врагов разные мечи: какой-то меч есть не у всех 16 и не ни у кого", "expect": "always",
          "condition": {
            "any": [
              { "count": { "all": [{ "component": "EnemyTag" }, { "field": "WeaponSlot.Index", "equals": 0 }] }, "between": [1, 15] },
              { "count": { "all": [{ "component": "EnemyTag" }, { "field": "WeaponSlot.Index", "equals": 1 }] }, "between": [1, 15] },
              { "count": { "all": [{ "component": "EnemyTag" }, { "field": "WeaponSlot.Index", "equals": 2 }] }, "between": [1, 15] },
              { "count": { "all": [{ "component": "EnemyTag" }, { "field": "WeaponSlot.Index", "equals": 3 }] }, "between": [1, 15] },
              { "count": { "all": [{ "component": "EnemyTag" }, { "field": "WeaponSlot.Index", "equals": 4 }] }, "between": [1, 15] },
              { "count": { "all": [{ "component": "EnemyTag" }, { "field": "WeaponSlot.Index", "equals": 5 }] }, "between": [1, 15] }
            ]
          }
        },
        {
          "id": "player-sword", "title": "до T у игрока sword_1h (combat.playerWeapon по умолчанию)", "expect": "always", "to": 60,
          "condition": { "all": [{ "entity": "player" }, { "field": "WeaponSlot.Index", "equals": 4 }, { "field": "Blade.Weapon", "equals": 4 }] }
        },
        {
          "id": "t-next", "title": "T — следующий меч: sword_dss, клинок им", "expect": "always", "from": 62, "to": 150,
          "condition": { "all": [{ "entity": "player" }, { "field": "WeaponSlot.Index", "equals": 5 }, { "field": "Blade.Weapon", "equals": 5 }] }
        },
        {
          "id": "reset-keeps", "title": "R — игрок построен заново с мечом инвентаря (sword_dss)", "expect": "always", "from": 152, "to": 200,
          "condition": { "all": [{ "entity": "player" }, { "field": "WeaponSlot.Index", "equals": 5 }, { "field": "Transform.Position.X", "between": [-0.5, 0.5] }] }
        },
        {
          "id": "t-wrap", "title": "T после последнего меча — первый (combat_sword)", "expect": "always", "from": 202, "to": 220,
          "condition": { "all": [{ "entity": "player" }, { "field": "WeaponSlot.Index", "equals": 0 }, { "field": "Blade.Weapon", "equals": 0 }] }
        },
        {
          "id": "equip", "title": "«взять меч 3» — katana_v2 в руке, клинок им, выбран в инвентаре", "expect": "always", "from": 222,
          "condition": { "all": [{ "entity": "player" }, { "field": "WeaponSlot.Index", "equals": 2 }, { "field": "Blade.Weapon", "equals": 2 }] }
        },
        {
          "id": "inventory", "title": "инвентарь: выбран katana_v2", "expect": "atEnd", "condition": { "resource": "PlayerInventory.Equipped", "equals": 2 }
        }
      ]
    },
    {
      "id": "strike-combo",
      "title": "игрок стоит, ЛКМ на тиках 30, 70, 120, 175 — удар slash1 сразу, нажатия во время удара ждут в буфере 0,3 с, связка slash1–4: каждый следующий — в первом тике после окна урона прошлого, прерывание видимого удара — снимок позы",
      "ticks": 300,
      "commands": [
        { "command": "PlayerCommand", "fields": { "Attack": true }, "from": 30, "to": 31 },
        { "command": "PlayerCommand", "fields": { "Attack": true }, "from": 70, "to": 71 },
        { "command": "PlayerCommand", "fields": { "Attack": true }, "from": 120, "to": 121 },
        { "command": "PlayerCommand", "fields": { "Attack": true }, "from": 175, "to": 176 }
      ],
      "checks": [
        {
          "id": "strike", "title": "ЛКМ — удар slash1 в тике нажатия, слоем верха", "expect": "eventually", "from": 30, "to": 32,
          "condition": { "all": [{ "entity": "player" }, { "field": "AnimatorAction.Kind", "equals": "Attack" }, { "field": "AnimatorAction.Attack", "equals": 0 }, { "field": "AnimatorAction.AttackSerial", "equals": 1 }, { "field": "AnimatorAction.Upper", "equals": true }] }
        },
        {
          "id": "buffered", "title": "второе нажатие до конца окна урона — ждёт в буфере, удар прежний", "expect": "always", "from": 72, "to": 78,
          "condition": { "all": [{ "entity": "player" }, { "field": "AnimatorAction.Attack", "equals": 0 }, { "field": "PlayerControl.SwingBuffer", "greaterThan": 0 }] }
        },
        {
          "id": "combo-2", "title": "slash2 — сразу после окна урона slash1, со снимком позы", "expect": "eventually", "from": 76, "to": 84,
          "condition": { "all": [{ "entity": "player" }, { "field": "AnimatorAction.Attack", "equals": 1 }, { "field": "AnimatorAction.AttackSerial", "equals": 2 }, { "field": "AnimatorAction.Snapshots", "equals": 1 }] }
        },
        {
          "id": "combo-4", "title": "связка из 4: slash4, номер удара 4", "expect": "eventually", "from": 178, "to": 192,
          "condition": { "all": [{ "entity": "player" }, { "field": "AnimatorAction.Attack", "equals": 3 }, { "field": "AnimatorAction.AttackSerial", "equals": 4 }] }
        }
      ]
    },
    {
      "id": "stab",
      "title": "Q на тике 30 — укол (клип уколов), связка не сдвинута",
      "ticks": 120,
      "commands": [{ "command": "PlayerCommand", "fields": { "Stab": true }, "from": 30, "to": 31 }],
      "checks": [
        {
          "id": "stab", "title": "Q — укол (удар 4…6 таблицы), связка — с начала", "expect": "eventually", "from": 30, "to": 32,
          "condition": { "all": [{ "entity": "player" }, { "field": "AnimatorAction.Kind", "equals": "Attack" }, { "field": "AnimatorAction.Attack", "greaterThan": 3 }, { "field": "AttackCombo.Next", "equals": 0 }] }
        }
      ]
    },
    {
      "id": "run-strike",
      "title": "бег вперёд, ЛКМ на тике 60 — удар слоем верха на бегу без замедления хода; после окна урона хвост удара обрезан (гаснет за 0,1 с)",
      "ticks": 240,
      "commands": [
        { "command": "PlayerCommand", "fields": { "Move": { "X": 0, "Y": 1 }, "HasGaze": true, "Gaze": { "X": 0, "Y": 0, "Z": 50 } }, "from": 0, "to": 240 },
        { "command": "PlayerCommand", "fields": { "Move": { "X": 0, "Y": 1 }, "HasGaze": true, "Gaze": { "X": 0, "Y": 0, "Z": 50 }, "Attack": true }, "from": 60, "to": 61 }
      ],
      "checks": [
        {
          "id": "not-slowed", "title": "скорость хода не падает (бег 4,2 м/с) — ни в ударе, ни после", "expect": "always", "from": 50,
          "condition": { "all": [{ "entity": "player" }, { "field": "RootVelocity.Value.Z", "greaterThan": 4.1 }] }
        },
        {
          "id": "legs-run", "title": "в ударе на бегу ноги у локомоции (доля клипа в ногах 0)", "expect": "eventually", "from": 62, "to": 100,
          "condition": { "all": [{ "entity": "player" }, { "field": "AnimatorAction.Kind", "equals": "Attack" }, { "field": "AnimatorAction.Stand", "equals": 0 }] }
        },
        {
          "id": "cut", "title": "хвост удара на бегу обрезан", "expect": "eventually", "from": 100, "to": 200,
          "condition": { "all": [{ "entity": "player" }, { "field": "AnimatorAction.CutRecovery", "equals": true }, { "field": "AnimatorAction.Kind", "equals": "Attack" }] }
        }
      ]
    },
    {
      "id": "dash",
      "title": "бег вперёд, Пробел на тике 60 — рывок: прибавка 9,5 м/с, гаснущая за 0,3 с (+1,46 м), вид — клип уклонения вперёд, неуязвимость; скорость хода не трогается — после рывка бег как был, без провала и инерции",
      "ticks": 240,
      "commands": [
