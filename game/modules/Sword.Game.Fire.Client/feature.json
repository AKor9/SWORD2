// Приёмка фичи «Огонь: горящий факел» (модуль Fire, клиентский: вне симуляции, хеша и реплея). Симуляция сценариев — факел в руке
// игрока (combat.playerWeapon=torch, индекс 6 в паке — последний), бег, замахи, смерть командой сцены (факел выпадает — огонь гаснет), T с
// факела и обратно; её проверки — оружие в руке, жив/мёртв, удары. Огонь сам — виды App по записи сценария (Sword.exe --replay, ночь —
// tune light.night=1): PNG и итог --json рядом (view-<id>.json: fire.metrics — высота и ширина пламени, доля ядра, столб дыма; fire.checks;
// fire.light, fire.smoke.stats). Бюджет — кадр App на записи «стоя» крупным планом ночью и GPU-время проходов огня (fire.* — пламя, дым,
// статистика дыма; fluid.* — шаг сима), Release. Решения и замеры — README модуля и docs/history/stage-f.md. Формат — FeatureManifest
// (Sword.Engine.Introspection), исполняет feature.verify (Sword.Headless --feature fire). Ослабить ожидания — только правкой с сообщением
// пользователю.
{
  "format": "sword-feature",
  "version": 1,
  "id": "fire",
  "title": "Огонь: горящий факел игрока (сим Fluid2D на шишке, пламя, дым, свет)",
  "doc": "README.md",
  "sourceRoots": [
    "game/modules/Sword.Game.Fire.Client",
    "engine/Sword.Engine.Fluid2D",
    "engine/Sword.Engine.Client/ClientModules.cs",
    "engine/Sword.Engine.Client/GpuSimulation.cs",
    "engine/Sword.Engine.Render/PointLights.cs",
    "engine/Sword.Engine.Render/HalfResTransparency.cs",
    "game/Sword.Game.Client/ArenaWeaponTips.cs",
    "game/Sword.Game.Contracts/WeaponTips.cs",
    "Bake/weapons/torch.bake.json",
    "Bake/effects/fire"
  ],
  "scenarios": [
    {
      "id": "stand",
      "title": "игрок с факелом стоит; два врага подходят и стоят рядом, не бьют (свет на соседях), 6 с",
      "set": ["combat.playerWeapon=torch", "arena.enemies=2", "combat.enemiesAttack=false"],
      "ticks": 720,
      "checks": [
        {
          "id": "torch", "title": "в руке факел: оружие 6 (torch), клинок посчитан факелом", "expect": "always",
          "condition": { "all": [{ "entity": "player" }, { "field": "WeaponSlot.Index", "equals": 6 }, { "field": "Blade.Weapon", "equals": 6 }] }
        },
        {
          "id": "alive", "title": "игрок жив", "expect": "always",
          "condition": { "all": [{ "entity": "player" }, { "not": { "component": "Dead" } }] }
        }
      ]
    },
    {
      "id": "run",
      "title": "игрок с факелом бежит по +X 6 с (шлейф назад)",
      "set": ["combat.playerWeapon=torch", "arena.enemies=0"],
      "ticks": 720,
      "commands": [{ "command": "PlayerCommand", "fields": { "Move": { "X": 1, "Y": 0 } }, "from": 0, "to": 720 }],
      "checks": [
        {
          "id": "torch", "title": "в руке факел", "expect": "always",
          "condition": { "all": [{ "entity": "player" }, { "field": "WeaponSlot.Index", "equals": 6 }] }
        },
        {
          "id": "ran", "title": "убежал дальше 5 м", "expect": "eventually",
          "condition": { "all": [{ "entity": "player" }, { "field": "Transform.Position.X", "greaterThan": 5 }] }
        }
      ]
    },
    {
      "id": "swing",
      "title": "игрок стоит и рубит факелом связкой 6 с (замахи в разные стороны экрана)",
      "set": ["combat.playerWeapon=torch", "arena.enemies=0"],
      "ticks": 720,
      "commands": [
        { "command": "PlayerCommand", "fields": { "Attack": true, "Gesture": { "X": 1, "Y": -1 } }, "from": 0, "to": 240 },
        { "command": "PlayerCommand", "fields": { "Attack": true, "Gesture": { "X": -1, "Y": 0 } }, "from": 240, "to": 480 },
        { "command": "PlayerCommand", "fields": { "Attack": true }, "from": 480, "to": 720 }
      ],
      "checks": [
        {
          "id": "torch", "title": "в руке факел", "expect": "always",
          "condition": { "all": [{ "entity": "player" }, { "field": "WeaponSlot.Index", "equals": 6 }] }
        },
        {
          "id": "swings", "title": "больше четырёх ударов", "expect": "eventually",
          "condition": { "all": [{ "entity": "player" }, { "field": "AnimatorAction.AttackSerial", "greaterThan": 4 }] }
        }
      ]
    },
    {
      "id": "death",
      "title": "игрок с факелом стоит 2 с и убит командой сцены (тик 240): труп на физике, факел выпадает — огонь гаснет (1,5 с); ещё 3 с",
      "set": ["combat.playerWeapon=torch", "arena.enemies=0"],
      "ticks": 600,
      "commands": [{ "command": "SceneCommand", "fields": { "Action": "Kill", "Slot": 0 }, "from": 240, "to": 241 }],
      "checks": [
        {
          "id": "alive", "title": "жив до смерти", "expect": "always", "to": 240,
          "condition": { "all": [{ "entity": "player" }, { "not": { "component": "Dead" } }] }
        },
        {
          "id": "dead", "title": "мёртв с тика смерти", "expect": "always", "from": 241,
          "condition": { "all": [{ "entity": "player" }, { "component": "Dead" }] }
        }
      ]
    },
    {
      "id": "switch",
      "title": "T с факела (тик 240: следующее оружие — первый меч пака), 1–9 обратно на факел (тик 480), 6 с",
      "set": ["combat.playerWeapon=torch", "arena.enemies=0"],
      "ticks": 720,
      "commands": [
        { "command": "ArenaCommand", "fields": { "Action": "NextWeapon" }, "from": 240, "to": 241 },
        { "command": "ArenaCommand", "fields": { "Action": "EquipWeapon", "Weapon": 6 }, "from": 480, "to": 481 }
      ],
      "checks": [
        {
          "id": "torch", "title": "до T — факел", "expect": "always", "to": 240,
          "condition": { "all": [{ "entity": "player" }, { "field": "WeaponSlot.Index", "equals": 6 }] }
        },
        {
          "id": "sword", "title": "после T — меч 0", "expect": "always", "from": 241, "to": 480,
          "condition": { "all": [{ "entity": "player" }, { "field": "WeaponSlot.Index", "equals": 0 }] }
        },
        {
          "id": "torch-again", "title": "снова факел", "expect": "always", "from": 481,
          "condition": { "all": [{ "entity": "player" }, { "field": "WeaponSlot.Index", "equals": 6 }] }
        }
      ]
    }
  ],
  "invariants": ["combat.*", "ecs.*"],
  "views": [
    {
      "id": "stand-night", "title": "ночь, 6 м: пламя над шишкой, дым вверх, тёплый свет на игроке, полу и двух врагах рядом (view-stand-night.json: fire.metrics)",
      "scenario": "stand", "tick": 600, "camera": "0.6,0.95,6,0,0", "tune": ["light.night=1"]
    },
    {
      "id": "stand-day", "title": "день, 6 м: пламя и светлый дым", "scenario": "stand", "tick": 600, "camera": "0.6,0.95,6,0,0"
    },
    {
      "id": "stand-overlay", "title": "ночь, 6 м, оверлеи fire (рамка площадки, центр шага, точка кисти) и lights (свет факела)",
      "scenario": "stand", "tick": 600, "camera": "0.6,0.95,6,0,0", "tune": ["light.night=1"], "overlays": ["fire", "lights"]
    },
    {
      "id": "stand-steep", "title": "ночь, наклон 80°: пламя к камере", "scenario": "stand", "tick": 600, "camera": "0.6,1.4,8,0,0", "tune": ["light.night=1"]
    },
    {
      "id": "run-night", "title": "ночь, бег (камера за игроком): пламя и дым тянутся назад", "scenario": "run", "tick": 360, "tune": ["light.night=1"]
    },
    {
      "id": "swing-night", "title": "ночь, 6 м, замах: огонь идёт за шишкой", "scenario": "swing", "tick": 470, "camera": "0.6,0.95,6,0,0", "tune": ["light.night=1"]
    },
    {
      "id": "death-burning", "title": "ночь, 6 м, за миг до смерти: факел горит", "scenario": "death", "tick": 236, "camera": "0.6,0.95,6,0,0", "tune": ["light.night=1"]
    },
    {
      "id": "death-out", "title": "ночь, 6 м, 3 с после смерти: факел на земле, огня, дыма и света нет", "scenario": "death", "tick": 600, "camera": "0.6,0.95,6,0,0", "tune": ["light.night=1"]
    },
    {
      "id": "switch-sword", "title": "ночь, 6 м: после T меч, огня нет", "scenario": "switch", "tick": 400, "camera": "0.6,0.95,6,0,0", "tune": ["light.night=1"]
    },
    {
      "id": "switch-torch", "title": "ночь, 6 м: снова факел — огонь заново", "scenario": "switch", "tick": 700, "camera": "0.6,0.95,6,0,0", "tune": ["light.night=1"]
    }
  ],
  "budgets": [
    // Пределы — около 2× замера verify.ps1 Release (RTX 5070, Ryzen 7 7800X3D, машина спокойна; окно 640×480, ночь, камера 6 м, 54°; README
    // модуля, «Приёмка»): кадр средний 0,236 мс (предел 0,5), p99 0,353 (2,5 — как у enemies и bodies); GPU на кадр: fire.* 0,0185 мс (предел
    // 0,05), fluid.* 0,0046 (шаг сима 60 Гц и экспорт поля каждый кадр — на кадр тем больше, чем реже кадры; при 200 кадрах/с — 0,0085; предел 0,025).
    {
      "id": "stand-night", "scenario": "stand",
      "frame": { "averageMs": 0.5, "p99Ms": 2.5, "seconds": 5, "camera": "0.6,0.95,6,0,0", "tune": ["light.night=1"], "gpu": { "fire": 0.05, "fluid": 0.025 } }
    }
  ],
  "checklist": [
    "`Sword.exe`, T (или I и строка torch) до факела: в правой руке палка с тёмной шишкой, над шишкой огонь и дым; справка F1 — «T — следующее оружие»; у врагов факела нет; удары факелом ранят.",
    "Ночь (F3 → «Свет» → «ночь»): арена тёмная, огонь светится, персонажи различимы.",
    "Стоя: пламя 25–30 см над шишкой — бело-жёлтое ядро, оранжевое тело, тёмно-красный край; дым поднимается вверх S-завитками, столб ≈2 высоты головы; частиц не видно.",
    "Бег (WASD): пламя и дым тянутся назад почти горизонтально.",
    "Замахи (ЛКМ связкой, Q): огонь идёт за шишкой, не отстаёт пятном и не «взрывается».",
    "Свет: тёплое мерцающее пятно на плече и голове, на полу ≈1,5 м вокруг; враги рядом подсвечены со стороны факела.",
    "Смерть с факелом (стоять и не отвечать врагам): труп падает, факел выпадает; пламя, дым и свет гаснут за ≈1,5 с и больше не загораются. R — игрок снова с факелом, огонь горит заново.",
    "Камера: наклоны 26°, 54°, 80° (средняя кнопка мыши) и приближение колесом до 3 м — нет швов, ореолов на краях персонажа, «картонности» (на 80° пламя — пятно, известное).",
    "День (ночь выкл.): огонь виден, дым светлый.",
    "F2: GPU-время проходов `fire.flame`, `fire.smoke`, `fluid.*` — доли миллисекунды.",
    "F3 «Огонь»: ручки пламени, дыма, плотности дыма, света и мерцания, вид поля, головки и площадка, скорость сима, затухание, кисть, k — огонь меняется сразу; ПКМ по подписи — к умолчанию.",
    "`Sword.exe --set modules.fire.enabled=false`: факел — палка без огня, дыма и света, игра стартует."
  ]
}
