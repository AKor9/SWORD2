        {
          "id": "mm", "title": "игрок на Motion Matching: клип базы (locomotion/, номера пака 182…625), у игрока нет состояния клипов (LegacyLocomotionState)", "expect": "always", "from": 1,
          "condition": { "all": [{ "entity": "player" }, { "field": "MotionMatchState.Clip", "between": [182, 625] }, { "not": { "component": "LegacyLocomotionState" } }] }
