<Project Sdk="Microsoft.NET.Sdk">

  <!-- Единая композиция симуляции: ядро и модули симуляции — одна для App и Headless (раздел 3). -->
  <PropertyGroup>
    <SwordSide>Simulation</SwordSide>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Sword.Game\Sword.Game.csproj" />
    <ProjectReference Include="..\..\engine\Sword.Engine.Runtime\Sword.Engine.Runtime.csproj" />
    <ProjectReference Include="..\Sword.Game.Contracts\Sword.Game.Contracts.csproj" />
  </ItemGroup>

  <!-- Модули симуляции. Сборка без модуля (-p:Without<Модуль>=true, раздел 7) — без ссылки на него. -->
  <ItemGroup Condition="'$(WithoutLocomotion)' != 'true'">
    <ProjectReference Include="..\modules\Sword.Game.Locomotion\Sword.Game.Locomotion.csproj" />
  </ItemGroup>
  <PropertyGroup Condition="'$(WithoutLocomotion)' == 'true'">
    <DefineConstants>$(DefineConstants);WITHOUT_LOCOMOTION</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="'$(WithoutCutting)' != 'true'">
    <ProjectReference Include="..\modules\Sword.Game.Cutting\Sword.Game.Cutting.csproj" />
  </ItemGroup>
  <PropertyGroup Condition="'$(WithoutCutting)' == 'true'">
    <DefineConstants>$(DefineConstants);WITHOUT_CUTTING</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="'$(WithoutImpact)' != 'true'">
    <ProjectReference Include="..\modules\Sword.Game.Impact\Sword.Game.Impact.csproj" />
  </ItemGroup>
  <PropertyGroup Condition="'$(WithoutImpact)' == 'true'">
    <DefineConstants>$(DefineConstants);WITHOUT_IMPACT</DefineConstants>
  </PropertyGroup>

</Project>
