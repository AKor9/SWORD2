<Project Sdk="Microsoft.NET.Sdk">

  <!-- Игра SWORD: композиция симуляции (Sword.Game.Bootstrap) и клиента. Модули симуляции сам не регистрирует. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>Sword</AssemblyName>
    <SwordSide>Client</SwordSide>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Direct3D.D3D12" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Sword.Game.Bootstrap\Sword.Game.Bootstrap.csproj" />
    <ProjectReference Include="..\Sword.Game.Client\Sword.Game.Client.csproj" />
    <ProjectReference Include="..\..\engine\Sword.Engine.Client\Sword.Engine.Client.csproj" />
    <ProjectReference Include="..\..\engine\Sword.Engine.Platform.Win32\Sword.Engine.Platform.Win32.csproj" />
  </ItemGroup>

  <!-- Агентский доступ (раздел 8): в сборке без агента (-p:WithoutAgent=true) его нет. -->
  <ItemGroup Condition="'$(WithoutAgent)' != 'true'">
    <ProjectReference Include="..\..\engine\Sword.Engine.Agent\Sword.Engine.Agent.csproj" />
    <ProjectReference Include="..\..\engine\Sword.Engine.Agent.Client\Sword.Engine.Agent.Client.csproj" />
    <ProjectReference Include="..\Sword.Game.Agent\Sword.Game.Agent.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(WithoutAgent)' == 'true'">
    <Compile Remove="AgentMode.cs" />
  </ItemGroup>

  <!-- App-local Agility SDK: D3D12Core.dll и слой отладки — в D3D12\ рядом с exe. -->
  <ItemGroup>
    <None Include="$(NuGetPackageRoot)microsoft.direct3d.d3d12\$(AgilitySdkVersion)\build\native\bin\x64\D3D12Core.dll"
          Link="D3D12\D3D12Core.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="$(NuGetPackageRoot)microsoft.direct3d.d3d12\$(AgilitySdkVersion)\build\native\bin\x64\d3d12SDKLayers.dll"
          Link="D3D12\d3d12SDKLayers.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
