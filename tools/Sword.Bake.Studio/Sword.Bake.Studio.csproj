<Project Sdk="Microsoft.NET.Sdk">

  <!-- Bake Studio: окно пекарни (ядро — tools/Sword.Bake) на движке SWORD2: окно Win32, рендер-граф и UI-проход, виджеты
       Sword.Engine.Ui. Обработчики проекта приходят из его плагинов (PluginLoader ядра), шрифты окна — системные:
       игровые ассеты и пак Studio не нужны. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Sword.Bake.Studio</RootNamespace>
    <SwordSide>Client</SwordSide>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Direct3D.D3D12" />
    <!-- контуры TrueType для пекаря системных шрифтов окна -->
    <PackageReference Include="StbTrueTypeSharp" />
  </ItemGroup>

  <!-- Пекарь шрифтов — исходником, а не ссылкой на сборку Sword.Bake.Engine: она — плагин проекта (bake.project.json →
       plugins), и её копия в процессе Studio мешала бы загрузке плагина (одноимённая сборка в контексте по умолчанию). -->
  <ItemGroup>
    <Compile Include="..\Sword.Bake.Engine\Font\UiFontBaker.cs" Link="Shared\UiFontBaker.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Sword.Bake\Sword.Bake.csproj" />
    <!-- сведения о сборке пака (PakBuildInfo): входы ассетов для слежения за исходниками -->
    <ProjectReference Include="..\..\engine\Sword.Engine.Content\Sword.Engine.Content.csproj" />
    <ProjectReference Include="..\..\engine\Sword.Engine.Formats\Sword.Engine.Formats.csproj" />
    <ProjectReference Include="..\..\engine\Sword.Engine.Diagnostics\Sword.Engine.Diagnostics.csproj" />
    <ProjectReference Include="..\..\engine\Sword.Engine.Ui\Sword.Engine.Ui.csproj" />
    <ProjectReference Include="..\..\engine\Sword.Engine.Render\Sword.Engine.Render.csproj" />
    <ProjectReference Include="..\..\engine\Sword.Engine.Client\Sword.Engine.Client.csproj" />
    <ProjectReference Include="..\..\engine\Sword.Engine.Platform\Sword.Engine.Platform.csproj" />
    <ProjectReference Include="..\..\engine\Sword.Engine.Platform.Win32\Sword.Engine.Platform.Win32.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Sword.Bake.Studio.Tests" />
  </ItemGroup>

  <!-- App-local Agility SDK — как у игры: D3D12Core.dll и слой отладки в D3D12\ рядом с exe. -->
  <ItemGroup>
    <None Include="$(NuGetPackageRoot)microsoft.direct3d.d3d12\$(AgilitySdkVersion)\build\native\bin\x64\D3D12Core.dll"
          Link="D3D12\D3D12Core.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="$(NuGetPackageRoot)microsoft.direct3d.d3d12\$(AgilitySdkVersion)\build\native\bin\x64\d3d12SDKLayers.dll"
          Link="D3D12\d3d12SDKLayers.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
