<Project Sdk="Microsoft.NET.Sdk">

  <!-- Пекарня sword-bake: сырой файл (raw-экспорт анимации, glTF, PNG, TTF, JSON) → конвертер по виду файла → файлы
       игровых форматов в Content/<тема>/…; параметры — рецепт Bake/recipes/<корень>/<путь сырого файла>.bake.json.
       Конвертеры движка и игры — папки этого проекта (Anim/, Texture/, Font/, Converters/). README.md. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Sword.Bake</RootNamespace>
    <AssemblyName>sword-bake</AssemblyName>
    <SwordSide>Neutral</SwordSide>
  </PropertyGroup>

  <ItemGroup>
    <!-- пути контента (ContentPath) -->
    <ProjectReference Include="..\..\engine\Sword.Engine.Content\Sword.Engine.Content.csproj" />
    <!-- писатели .swclip, .swskeleton, .swmesh, .swtex, .swfont -->
    <ProjectReference Include="..\..\engine\Sword.Engine.Formats\Sword.Engine.Formats.csproj" />
    <!-- система корневого движения (MotionMatrix), прямая кинематика (Skeleton) -->
    <ProjectReference Include="..\..\engine\Sword.Engine.Animation\Sword.Engine.Animation.csproj" />
    <!-- формат зон крови оружия .swblood -->
    <ProjectReference Include="..\..\game\Sword.Game.Data\Sword.Game.Data.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- контуры TrueType для пекаря шрифтов (UiFontBaker) -->
    <PackageReference Include="StbTrueTypeSharp" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Sword.Bake.Tests" />
    <InternalsVisibleTo Include="sword-assets" />
    <InternalsVisibleTo Include="Sword.Assets.Tests" />
  </ItemGroup>

</Project>
