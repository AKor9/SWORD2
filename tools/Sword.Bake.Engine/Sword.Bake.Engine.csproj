<Project Sdk="Microsoft.NET.Sdk">

  <!-- Обработчики пекарни движка — плагин проекта (bake.project.json → plugins, первым): скелет и риг (anim.skeleton),
       меш персонажа (skin.mesh), клипы raw-экспорта Unreal → наборы библиотеки анимаций (anim.pack) и команда
       sword-bake inspect. Сами конвертеры — Anim/. Ядро (tools/Sword.Bake) об этом плагине не знает; плагин игры
       Sword.Bake.Game (Б5) ссылается на этот так же, как на ядро. Перенесено из SWORD 2eab13b — README.md. -->
  <PropertyGroup>
    <RootNamespace>Sword.Bake.Engine</RootNamespace>
    <SwordSide>Neutral</SwordSide>
    <!-- плагин грузится хостом пекарни: зависимости рядом со сборкой, путь без TFM — bin/<конфигурация>/Sword.Bake.Engine.dll -->
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <!-- ядро даёт хост: своя копия сломала бы общие типы IAssetProcessor -->
    <ProjectReference Include="..\Sword.Bake\Sword.Bake.csproj" Private="false" ExcludeAssets="runtime" />
    <!-- пути контента (ContentPath), пак для inspect -->
    <ProjectReference Include="..\..\engine\Sword.Engine.Content\Sword.Engine.Content.csproj" />
    <!-- писатели .swclip, .swskeleton, .swmesh -->
    <ProjectReference Include="..\..\engine\Sword.Engine.Formats\Sword.Engine.Formats.csproj" />
    <!-- контейнер клипов импорта (ClipLibrary), система корневого движения (MotionMatrix), прямая кинематика (Skeleton) -->
    <ProjectReference Include="..\..\engine\Sword.Engine.Animation\Sword.Engine.Animation.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Sword.Bake.Engine.Tests" />
  </ItemGroup>

</Project>
