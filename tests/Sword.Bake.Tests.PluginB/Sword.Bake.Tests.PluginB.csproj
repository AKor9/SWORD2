<Project Sdk="Microsoft.NET.Sdk">

  <!-- Тестовый плагин пекарни B — «надстройка» (как Sword.Bake.Game): его обработчик наследует основу плагина A и читает
       параметры единицы A (ctx.Ref). На A ссылается, как на ядро: сборку A даёт хост (A загружен раньше по списку
       plugins), своей копии рядом с B нет. -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\tools\Sword.Bake\Sword.Bake.csproj" Private="false" ExcludeAssets="runtime" />
    <ProjectReference Include="..\Sword.Bake.Tests.PluginA\Sword.Bake.Tests.PluginA.csproj" Private="false" ExcludeAssets="runtime" />
  </ItemGroup>

</Project>
