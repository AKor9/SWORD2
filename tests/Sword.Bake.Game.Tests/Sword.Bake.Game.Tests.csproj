<Project Sdk="Microsoft.NET.Sdk">

  <!-- Плагин пекарни игры (tools/Sword.Bake.Game): зоны крови оружия — синтетика (перенесено из тестов SWORD), оба плагина
       пекарни в процессе sword-bake (порядок plugins, один тип параметров рига), категория Content — формат .swblood на
       эталонном паке, категория Source — выпечка оружия и анатомии из настоящих исходников и сверка с эталонным паком
       (без исходников — пропуск). -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- пути решения, запуск sword-bake, итог Source и синтетический риг — общие с тестами плагина движка -->
    <Compile Include="..\Sword.Bake.Engine.Tests\TestPaths.cs" Link="Shared\TestPaths.cs" />
    <Compile Include="..\Sword.Bake.Engine.Tests\SynthSkeleton.cs" Link="Shared\SynthSkeleton.cs" />
    <Compile Include="..\Sword.Bake.Engine.Tests\SynthMesh.cs" Link="Shared\SynthMesh.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- конвертеры — напрямую (InternalsVisibleTo); ядро и плагин движка плагину даёт хост, здесь хост — тесты -->
    <ProjectReference Include="..\..\tools\Sword.Bake.Game\Sword.Bake.Game.csproj" />
    <ProjectReference Include="..\..\tools\Sword.Bake.Engine\Sword.Bake.Engine.csproj" />
    <ProjectReference Include="..\..\tools\Sword.Bake\Sword.Bake.csproj" />
    <ProjectReference Include="..\..\engine\Sword.Engine.Content\Sword.Engine.Content.csproj" />
    <ProjectReference Include="..\..\engine\Sword.Engine.Formats\Sword.Engine.Formats.csproj" />
    <ProjectReference Include="..\..\game\Sword.Game.Data\Sword.Game.Data.csproj" />
    <!-- sword-bake.exe запускается процессом из своего выхода: ссылка только ради порядка сборки -->
    <ProjectReference Include="..\..\tools\Sword.Bake.Cli\Sword.Bake.Cli.csproj" ReferenceOutputAssembly="false" Private="false" />
  </ItemGroup>

</Project>
