<Project Sdk="Microsoft.NET.Sdk">

  <!-- Архитектурные тесты: граф проектов решения против правил раздела 4 ARCHITECTURE_PLAN.md. Проекты движка и игры
       не подключаются — тесты читают SWORD.slnx и .csproj с диска. -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
