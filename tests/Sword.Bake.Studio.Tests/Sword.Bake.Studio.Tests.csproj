<Project Sdk="Microsoft.NET.Sdk">

  <!-- Bake Studio без окна: модель на проекте Bake/ (плагины грузятся загрузчиком ядра), форма параметров туда и обратно,
       запись манифеста, добавление и удаление ассета, сборка из Studio против sword-bake, шрифты окна, ключи; с окном
       (категория Gpu) — снимок без фокуса. -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\tools\Sword.Bake.Studio\Sword.Bake.Studio.csproj" />
    <ProjectReference Include="..\..\tools\Sword.Bake\Sword.Bake.csproj" />
    <ProjectReference Include="..\..\engine\Sword.Engine.Content\Sword.Engine.Content.csproj" />
    <ProjectReference Include="..\..\engine\Sword.Engine.Ui\Sword.Engine.Ui.csproj" />
    <!-- Плагины проекта Bake/ и sword-bake — по путям их выхода: ссылки только ради порядка сборки, их сборок в выходе
         тестов нет — иначе плагины попали бы в контекст по умолчанию мимо загрузчика плагинов. -->
    <ProjectReference Include="..\..\tools\Sword.Bake.Engine\Sword.Bake.Engine.csproj" ReferenceOutputAssembly="false" Private="false" />
    <ProjectReference Include="..\..\tools\Sword.Bake.Game\Sword.Bake.Game.csproj" ReferenceOutputAssembly="false" Private="false" />
    <ProjectReference Include="..\..\tools\Sword.Bake.Cli\Sword.Bake.Cli.csproj" ReferenceOutputAssembly="false" Private="false" />
  </ItemGroup>

</Project>
