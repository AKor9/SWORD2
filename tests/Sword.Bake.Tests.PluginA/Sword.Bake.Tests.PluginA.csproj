<Project Sdk="Microsoft.NET.Sdk">

  <!-- Тестовый плагин пекарни A — «основа» (как Sword.Bake.Engine): обработчик скелета и основа обработчиков на скелете,
       которую наследует плагин B. Собран как настоящий плагин: EnableDynamicLoading, выход bin/<конфигурация>/ без TFM,
       ядро даёт хост. Грузят тесты Sword.Bake.Tests (PluginTests) по пути. -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <!-- ядро даёт хост: своя копия сломала бы общие типы IAssetProcessor -->
    <ProjectReference Include="..\..\tools\Sword.Bake\Sword.Bake.csproj" Private="false" ExcludeAssets="runtime" />
  </ItemGroup>

</Project>
