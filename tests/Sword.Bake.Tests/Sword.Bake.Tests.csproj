<Project Sdk="Microsoft.NET.Sdk">

  <!-- Пекарня (tools/Sword.Bake): конвертеры на синтетике (glTF, маршрутизация наборов, корневое движение, оси UE и окно
       пальцев, хват, зоны крови, текстуры, шрифты, хеш исходника клипа), таблица видов файлов, рецепты и sword-bake
       процессом на синтетическом риге — выход каждого конвертера читается читателем формата. -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- конвертеры — напрямую (InternalsVisibleTo); sword-bake.exe запускается процессом из своего выхода -->
    <ProjectReference Include="..\..\tools\Sword.Bake\Sword.Bake.csproj" />
    <ProjectReference Include="..\..\engine\Sword.Engine.Content\Sword.Engine.Content.csproj" />
    <ProjectReference Include="..\..\engine\Sword.Engine.Formats\Sword.Engine.Formats.csproj" />
    <ProjectReference Include="..\..\engine\Sword.Engine.Animation\Sword.Engine.Animation.csproj" />
    <ProjectReference Include="..\..\game\Sword.Game.Data\Sword.Game.Data.csproj" />
  </ItemGroup>

</Project>
