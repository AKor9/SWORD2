<Project Sdk="Microsoft.NET.Sdk">

  <!-- Тесты игры: описание арены (рельеф, колонны), движение игрока и анимация в симуляции (та же композиция, что у
       игры), сверка с SWORD на эталонном паке, инструменты агента игры. -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Microsoft.Direct3D.D3D12" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\game\Sword.Game\Sword.Game.csproj" />
    <ProjectReference Include="..\..\game\Sword.Game.Bootstrap\Sword.Game.Bootstrap.csproj" />
    <ProjectReference Include="..\..\game\Sword.Game.Client\Sword.Game.Client.csproj" />
    <ProjectReference Include="..\..\game\Sword.Game.Agent\Sword.Game.Agent.csproj" />
    <ProjectReference Include="..\..\engine\Sword.Engine.Platform.Win32\Sword.Engine.Platform.Win32.csproj" />
    <!-- Разбор ключей Sword.exe (фокус окна, SWORD_NO_ACTIVATE): AppOptionsTests. -->
    <ProjectReference Include="..\..\game\Sword.Game.App\Sword.Game.App.csproj" />
  </ItemGroup>

  <!-- GPU-тест ID-прохода и оверлея капсул (категории Gpu и Content): App-local Agility SDK, как у игры. -->
  <ItemGroup>
    <None Include="$(NuGetPackageRoot)microsoft.direct3d.d3d12\$(AgilitySdkVersion)\build\native\bin\x64\D3D12Core.dll"
          Link="D3D12\D3D12Core.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(NuGetPackageRoot)microsoft.direct3d.d3d12\$(AgilitySdkVersion)\build\native\bin\x64\d3d12SDKLayers.dll"
          Link="D3D12\d3d12SDKLayers.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
