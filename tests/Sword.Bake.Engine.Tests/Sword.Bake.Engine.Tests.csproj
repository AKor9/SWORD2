<Project Sdk="Microsoft.NET.Sdk">

  <!-- Плагин пекарни движка (tools/Sword.Bake.Engine): glTF, маршрутизация наборов, корневое движение, оси UE и окно
       пальцев, ID импорта, хеш исходника клипа — синтетика, спецификация пекарни (перенесено из тестов плагина SWORD);
       выпечка синтетического рига процессом sword-bake; категория Source — выпечка настоящих исходников и сверка
       с эталонным паком (без исходников — пропуск). -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- конвертеры и обработчики — напрямую (InternalsVisibleTo); ядро плагину даёт хост, здесь хост — тесты -->
    <ProjectReference Include="..\..\tools\Sword.Bake.Engine\Sword.Bake.Engine.csproj" />
    <ProjectReference Include="..\..\tools\Sword.Bake\Sword.Bake.csproj" />
    <ProjectReference Include="..\..\engine\Sword.Engine.Content\Sword.Engine.Content.csproj" />
    <ProjectReference Include="..\..\engine\Sword.Engine.Formats\Sword.Engine.Formats.csproj" />
    <ProjectReference Include="..\..\engine\Sword.Engine.Animation\Sword.Engine.Animation.csproj" />
    <!-- sword-bake.exe запускается процессом из своего выхода: ссылка только ради порядка сборки -->
    <ProjectReference Include="..\..\tools\Sword.Bake.Cli\Sword.Bake.Cli.csproj" ReferenceOutputAssembly="false" Private="false" />
  </ItemGroup>

</Project>
