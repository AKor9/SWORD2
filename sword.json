{
  // Конфиг SWORD2 (раздел 7 ARCHITECTURE_PLAN.md): значения в коде → этот файл → sword.user.json (вне git) →
  // переменные SWORD_<СЕКЦИЯ>_<КЛЮЧ> → ключи --set секция.ключ=значение. Неизвестная секция или ключ — ошибка.
  "sim": {
    "tickRate": 120,
    "maxTicksPerFrame": 8
  },
  // Арена: врагов при старте — 0…32, как Units SWORD (ключ exe --units N). Значение в коде — 0: мир без
  // этого файла (тесты, сценарии фич, реплеи без врагов) — пустая арена.
  "arena": {
    "enemies": 10
  },
  // Локомоция: походка игрока — "mm" (Motion Matching по клипам GASP) или "clips" (клипами, как враги). Значение в коде —
  // "clips": мир без этого файла (тесты, сценарии фич, эталоны SWORD2) ходит клипами. Ручки «Локомоция» (locomotion.searchPeriod и др.) —
  // README модуля Locomotion.
  "locomotion": {
    "player": "mm"
  }
}
